BOOST_AUTO_TEST_CASE(model_condition_catalog_has_stable_exhaustive_ids_and_names)
{
	BOOST_TEST(SchemaVersion == 1u);
	BOOST_TEST(ConditionCount == std::size_t{118});
	BOOST_TEST(ConditionWordCount == std::size_t{2});
	BOOST_TEST(static_cast<std::uint16_t>(ModelCondition::Count) == std::uint16_t{118});

	for (std::size_t index = 0u; index < ConditionCount; ++index)
	{
		const auto &entry = ExpectedCatalog[index];
		BOOST_TEST(static_cast<std::size_t>(entry.condition) == index);
		BOOST_TEST(Name(entry.condition) == entry.name);
		BOOST_TEST(ConditionNames[index] == entry.name);
		for (std::size_t other = index + 1u; other < ConditionCount; ++other)
			BOOST_CHECK(entry.name != ExpectedCatalog[other].name);
	}
}

BOOST_AUTO_TEST_CASE(surrender_is_always_part_of_the_modern_catalog)
{
	BOOST_TEST(static_cast<std::size_t>(ModelCondition::SURRENDER) == std::size_t{103});
	BOOST_TEST(Name(ModelCondition::SURRENDER) == "SURRENDER");
}

BOOST_AUTO_TEST_CASE(condition_mask_sets_cross_word_and_high_flags_to_exact_words)
{
	ConditionMask mask;
	BOOST_CHECK(mask.Empty());

	mask.Set(ModelCondition::OVER_WATER);
	mask.Set(ModelCondition::PACKING);
	mask.Set(ModelCondition::WEAPONSET_VETERAN);

	const std::array<std::uint64_t, ConditionWordCount> expected{
		std::uint64_t{1} << 63,
		(std::uint64_t{1} << 53) | std::uint64_t{1}};
	BOOST_CHECK(mask.words == expected);
	BOOST_CHECK(mask.Contains(ModelCondition::OVER_WATER));
	BOOST_CHECK(mask.Contains(ModelCondition::PACKING));
	BOOST_CHECK(mask.Contains(ModelCondition::WEAPONSET_VETERAN));
	BOOST_CHECK(!mask.Contains(ModelCondition::NIGHT));
	BOOST_CHECK(!mask.Contains(ModelCondition::PANICKING));
}

BOOST_AUTO_TEST_CASE(condition_mask_apply_clears_then_sets_overlapping_flags)
{
	ConditionMask mask;
	mask.Set(ModelCondition::OVER_WATER);
	mask.Set(ModelCondition::PACKING);
	mask.Set(ModelCondition::SURRENDER);

	ConditionMask clearMask;
	clearMask.Set(ModelCondition::OVER_WATER);
	clearMask.Set(ModelCondition::PACKING);
	clearMask.Set(ModelCondition::SURRENDER);

	ConditionMask setMask;
	setMask.Set(ModelCondition::PACKING);
	setMask.Set(ModelCondition::WEAPONSET_VETERAN);
	mask.Apply(clearMask, setMask);

	const std::array<std::uint64_t, ConditionWordCount> expected{
		std::uint64_t{0},
		(std::uint64_t{1} << 53) | std::uint64_t{1}};
	BOOST_CHECK(mask.words == expected);
	BOOST_CHECK(mask.Empty() == false);
	BOOST_CHECK(!mask.Contains(ModelCondition::OVER_WATER));
	BOOST_CHECK(mask.Contains(ModelCondition::PACKING));
	BOOST_CHECK(!mask.Contains(ModelCondition::SURRENDER));
	BOOST_CHECK(mask.Contains(ModelCondition::WEAPONSET_VETERAN));
}

BOOST_AUTO_TEST_CASE(condition_mask_reset_returns_all_words_to_zero)
{
	ConditionMask mask;
	mask.Set(ModelCondition::TOPPLED);
	mask.Set(ModelCondition::WEAPONSET_PLAYER_UPGRADE);
	mask.Reset();

	BOOST_CHECK(mask.Empty());
	const std::array<std::uint64_t, ConditionWordCount> expected{};
	BOOST_CHECK(mask.words == expected);
}

BOOST_AUTO_TEST_CASE(condition_masks_are_independent_value_objects)
{
	ConditionMask first;
	ConditionMask second;
	first.Set(ModelCondition::TOPPLED);
	second.Set(ModelCondition::SURRENDER);

	BOOST_CHECK(first.Contains(ModelCondition::TOPPLED));
	BOOST_CHECK(!first.Contains(ModelCondition::SURRENDER));
	BOOST_CHECK(!second.Contains(ModelCondition::TOPPLED));
	BOOST_CHECK(second.Contains(ModelCondition::SURRENDER));

	const auto copy = first;
	first.Clear(ModelCondition::TOPPLED);
	BOOST_CHECK(first.Empty());
	BOOST_CHECK(copy.Contains(ModelCondition::TOPPLED));
}
