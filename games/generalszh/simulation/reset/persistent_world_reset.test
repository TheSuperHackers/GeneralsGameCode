	BOOST_TEST(state.Count() == 0u);
	BOOST_TEST(balances.poisoned);
	BOOST_TEST(schedules.poisoned);
	BOOST_TEST(balances.failCount == 1u);
	BOOST_TEST(schedules.failCount == 1u);
	BOOST_TEST(balances.discardCount == 1u);
	BOOST_TEST(schedules.discardCount == 1u);
	const std::array expected{
		CallbackEntry{BalanceName, CallbackKind::Capture},
		CallbackEntry{ScheduleName, CallbackKind::Capture},
		CallbackEntry{BalanceName, CallbackKind::Release},
		CallbackEntry{ScheduleName, CallbackKind::Release},
		CallbackEntry{BalanceName, CallbackKind::Restore},
		CallbackEntry{ScheduleName, CallbackKind::Restore},
		CallbackEntry{BalanceName, CallbackKind::Fail},
		CallbackEntry{ScheduleName, CallbackKind::Fail},
		CallbackEntry{BalanceName, CallbackKind::Discard},
		CallbackEntry{ScheduleName, CallbackKind::Discard}};
	CheckLog(log, expected);
	BOOST_TEST(balances.entities.empty());
	BOOST_TEST(schedules.entities.empty());
	BOOST_TEST(balances.capturedValues.empty());
	BOOST_TEST(schedules.capturedValues.empty());
	BOOST_CHECK_THROW(PersistentWorldReset::Execute(
		state, std::span<const PersistentResetParticipant>{}), std::logic_error);
	BOOST_CHECK_THROW(state.Reset(), std::logic_error);
	BOOST_TEST(state.Count() == 0u);
}

BOOST_AUTO_TEST_CASE(reentrant_reset_attempts_are_rejected_while_capture_is_in_progress)
{
	using namespace persistent_world_reset_test;
	GameplayState state;
	CallbackLog log;
	BalanceParticipant balances(state, log);
	balances.Create(29, 4, 10);
	balances.attemptGameplayReset = true;
	balances.attemptReentrantCoordinatorReset = true;
	const std::array participants{balances.Descriptor()};

	BOOST_CHECK_NO_THROW(PersistentWorldReset::Execute(state, participants));
	BOOST_TEST(balances.gameplayResetRejected);
	BOOST_TEST(balances.reentrantCoordinatorResetRejected);
	BOOST_TEST(state.Count() == 1u);
	DestroyOwned(balances);
}

BOOST_AUTO_TEST_CASE(scheduled_reset_is_rejected_before_any_participant_callback)
{
	using namespace persistent_world_reset_test;
	GameplayState state;
	CallbackLog log;
	BalanceParticipant balances(state, log);
	balances.Create(43, 5, 16);
	const auto entity = balances.entities.front();
	const auto before = *state.World().Get<ResourceBalance>(entity);
	ScheduledResetSystem system;
	system.participant = balances.Descriptor();
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(state.World().Components());
	ecs::Scheduler scheduler(state.World(), systems, engine::jobs::JobSystemConfig{1});
	const engine::time::FixedStep step{60};
	scheduler.Finalize(step);

	// The scheduler owns the real scheduled-execution boundary. The reset
	// request reaches GameplayState::BeginReset while that boundary is active,
	// so it must fail before capture and make the scheduler tick fatal.
	BOOST_CHECK_THROW(scheduler.Execute(engine::time::SimulationTime{1, step}), std::logic_error);
	BOOST_TEST(scheduler.IsFailed());
	BOOST_TEST(!state.World().IsScheduledExecutionActive());
	BOOST_TEST(system.executions == 1u);
	BOOST_TEST(state.Count() == 1u);
	BOOST_TEST(state.World().Get<ResourceBalance>(entity)->quantity == before.quantity);
	BOOST_TEST(log.size == 0u);
	BOOST_TEST(balances.captureCount == 0u);
	BOOST_TEST(balances.discardCount == 0u);
	BOOST_CHECK_THROW(scheduler.Execute(engine::time::SimulationTime{2, step}), std::logic_error);
	DestroyOwned(balances);
}

BOOST_AUTO_TEST_CASE(stable_names_require_canonical_lowercase_ascii)
{
	using namespace persistent_world_reset_test;
	const std::array invalidNames{
		std::string_view{"Tests.persistent.accounts"},
		std::string_view{"tests.Persistent.accounts"},
		std::string_view{"tests.persistent accounts"},
		std::string_view{"tests.persistent:accounts"},
		std::string_view{"tests.persistent.\xC3\xA9"}};

	for (const auto invalidName : invalidNames)
	{
		GameplayState state;
		CallbackLog log;
		BalanceParticipant balances(state, log, invalidName);
		balances.Create(47, 6, 17);
		const auto entity = balances.entities.front();
		const auto before = *state.World().Get<ResourceBalance>(entity);
		const auto descriptor = balances.Descriptor();
		BOOST_CHECK_THROW(PersistentWorldReset::Execute(state, std::span{&descriptor, 1}), std::invalid_argument);
		BOOST_TEST(state.Count() == 1u);
		BOOST_TEST(state.World().Get<ResourceBalance>(entity)->quantity == before.quantity);
		BOOST_TEST(log.size == 0u);
		DestroyOwned(balances);
	}

	{
		GameplayState state;
		CallbackLog log;
		BalanceParticipant balances(state, log, "a-z_0/9");
		balances.Create(53, 7, 19);
		const auto descriptor = balances.Descriptor();
		BOOST_CHECK_NO_THROW(PersistentWorldReset::Execute(state, std::span{&descriptor, 1}));
		BOOST_TEST(state.Count() == 1u);
		DestroyOwned(balances);
	}
}

