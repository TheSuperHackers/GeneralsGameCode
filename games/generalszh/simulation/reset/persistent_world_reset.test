	BOOST_TEST(log.size == 0u);
	DestroyOwned(balances);
}

BOOST_AUTO_TEST_CASE(each_missing_callback_is_rejected_without_callbacks_or_mutation)
{
	using namespace persistent_world_reset_test;
	for (int missing = 0; missing < 6; ++missing)
	{
		GameplayState state;
		CallbackLog log;
		BalanceParticipant balances(state, log);
		balances.Create(37, 6, 11);
		auto descriptor = balances.Descriptor();
		switch (missing)
		{
		case 0: descriptor.capture = nullptr; break;
		case 1: descriptor.release = nullptr; break;
		case 2: descriptor.restore = nullptr; break;
		case 3: descriptor.discard = nullptr; break;
		case 4: descriptor.fail = nullptr; break;
		case 5: descriptor.context = nullptr; break;
		default: break;
		}
		const auto entity = balances.entities.front();
		const auto before = *state.World().Get<ResourceBalance>(entity);
		BOOST_CHECK_THROW(PersistentWorldReset::Execute(state, std::span{&descriptor, 1}), std::invalid_argument);
		BOOST_TEST(state.Count() == 1u);
		BOOST_TEST(state.World().Get<ResourceBalance>(entity)->quantity == before.quantity);
		BOOST_TEST(log.size == 0u);
		DestroyOwned(balances);
	}
}

