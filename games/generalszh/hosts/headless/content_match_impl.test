BOOST_AUTO_TEST_CASE(decoded_payload_catalog_runs_through_game_session_with_owner_membership_and_stable_ids)
{
    const auto carrier=generalszh::content::DecodeUnit(R"(
Object PayloadCarrier
 KindOf = VEHICLE TRANSPORT
 Behavior = TransportContain CarrierTransport
  Slots = 4
  InitialPayload = PayloadInfantry 2
 End
 BuildCost = 10
 BuildTime = 0
 Body = ActiveBody Tag
  MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY PayloadGun
 End
 Locomotor = SET_NORMAL PayloadDrive
End
)",R"(
Weapon PayloadGun
 PrimaryDamage = 5
 AttackRange = 100
 DelayBetweenShots = 100
End
)","Locomotor PayloadDrive\nSpeed = 200\nEnd","PayloadCarrier");
    const auto passenger=generalszh::content::DecodeUnit(R"(
Object PayloadInfantry
 KindOf = INFANTRY
 TransportSlotCount = 1
 BuildCost = 1
 BuildTime = 0
 Body = ActiveBody Tag
  MaxHealth = 25
 End
 Locomotor = SET_NORMAL PayloadInfantryDrive
End
)","","Locomotor PayloadInfantryDrive\nSpeed = 200\nEnd","PayloadInfantry");
    BOOST_REQUIRE(carrier.initialPayload); BOOST_REQUIRE(passenger.definition.passenger);
    std::array supporting{passenger}; generalszh::headless::ContentExercise exercise;
    exercise.supportingCatalog=std::span<const generalszh::content::DecodedUnit>{supporting};
    const auto run=[&](std::size_t workers) { return generalszh::headless::RunDecodedMatch(carrier,workers,64,exercise); };
    const auto expected=run(1);
    BOOST_REQUIRE(expected.initialPayloadPresent); BOOST_REQUIRE(expected.initialPayloadConsumed);
    BOOST_TEST(expected.initialPayloadConfiguredCount==2u); BOOST_TEST(expected.initialPayloadSpawnCount==2u);
    BOOST_TEST(expected.initialPayloadSpawned); BOOST_TEST(expected.initialPayloadSpawnTick==1u);
    BOOST_CHECK(expected.initialPayloadCarrier==expected.attacker);
    BOOST_REQUIRE_EQUAL(expected.initialPayloadState.size(),16u);
    for(std::size_t i=0;i<2;++i)
    {
        const auto offset=i*8;
        BOOST_TEST(expected.initialPayloadState[offset+2]==expected.attackerAccount.index);
        BOOST_TEST(expected.initialPayloadState[offset+3]==expected.attackerAccount.generation);
        BOOST_TEST(expected.initialPayloadState[offset+4]==expected.initialPayloadCarrier.index);
        BOOST_TEST(expected.initialPayloadState[offset+5]==expected.initialPayloadCarrier.generation);
        BOOST_TEST(expected.initialPayloadState[offset+6]==passenger.definition.key);
        BOOST_TEST(expected.initialPayloadState[offset+7]==static_cast<std::uint64_t>(engine::gameplay::containment::ContainmentPhase::Inside));
    }
    for(const auto workers:{2u,4u})
    {
        const auto actual=run(workers);
        BOOST_CHECK(actual.initialPayloadState==expected.initialPayloadState);
        BOOST_CHECK(actual.initialPayloadCarrier==expected.initialPayloadCarrier);
        BOOST_TEST(actual.initialPayloadSpawnTick==expected.initialPayloadSpawnTick);
        BOOST_CHECK(actual.state==expected.state);
    }
}

BOOST_AUTO_TEST_CASE(decoded_detector_and_stealth_units_reach_production_and_global_reveal_targeting_at_one_two_four_workers)
{
    const auto detector=generalszh::content::DecodeUnit(R"(
Object DetectorUnit
 BuildCost = 1
 BuildTime = 0
 VisionRange = 400
 Body = ActiveBody Body
 MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY Probe
 End
 Behavior = StealthDetectorUpdate Detector
  DetectionRate = 100
  DetectionRange = 0
  CanDetectWhileContained = No
 End
 Locomotor = SET_NORMAL Walk
End
)",R"(
Weapon Probe
 PrimaryDamage = 1
 AttackRange = 10
End
)","Locomotor Walk\nSpeed = 20\nEnd","DetectorUnit");
    const auto concealed=generalszh::content::DecodeUnit(R"(
Object ConcealedUnit
 BuildCost = 1
 BuildTime = 0
 Body = ActiveBody Body
 MaxHealth = 100
 End
 Behavior = StealthUpdate Cloak
  StealthDelay = 0
  InnateStealth = Yes
 End
 Locomotor = SET_NORMAL Walk
End
)","","Locomotor Walk\nSpeed = 20\nEnd","ConcealedUnit");
    BOOST_CHECK(!detector.definition.concealment);
    BOOST_REQUIRE(detector.definition.detection);
    BOOST_REQUIRE(concealed.definition.concealment);
    BOOST_REQUIRE(concealed.definition.stealthPolicy);
    generalszh::headless::ContentExercise exercise; exercise.passiveTarget=&concealed;
    const auto run=[&](const std::size_t workers) {
        return generalszh::headless::RunDecodedMatch(detector,workers,5,exercise);
    };
    const auto expected=run(1);
    BOOST_CHECK(!expected.concealmentPresent); // Detector-only enrollment does not cloak by default.
    BOOST_CHECK(expected.detectorPresent);
    BOOST_CHECK(expected.targetConcealmentPresent);
    BOOST_CHECK(!expected.targetDetectorPresent);
    BOOST_CHECK(expected.targetDetectedAtEnd);
    for(const auto workers:{2u,4u})
    {
        const auto actual=run(workers);
        BOOST_CHECK(actual.state==expected.state);
        BOOST_CHECK(actual.attacker==expected.attacker); BOOST_CHECK(actual.target==expected.target);
        BOOST_CHECK(actual.targetDetectedAtEnd);
    }
}

BOOST_AUTO_TEST_CASE(decoded_science_purchase_reaches_produced_unit_at_one_two_four_workers)
{
    using namespace engine::gameplay::rts::unlocks;
    const auto decodedScience=generalszh::content::DecodeScienceDefinitions(R"(
Science SCIENCE_GATE
 SciencePurchasePointCost = 3
 IsGrantable = Yes
 PrerequisiteSciences = None
End
)");
    const auto scienceDefinitions=generalszh::content::BindScienceDefinitions(decodedScience);
    UnlockCatalog scienceCatalog;
    for (const auto &definition:scienceDefinitions) scienceCatalog.Register(definition);
    scienceCatalog.Finalize();
    const auto scienceKey=MakeUnlockKey("SCIENCE_GATE");
    const auto scienceId=scienceCatalog.Find(scienceKey);
    const auto scienceSchemaHash=scienceCatalog.SchemaHash();
    const auto unit=generalszh::content::DecodeUnit(R"(
Object ScienceInfantry
 KindOf = INFANTRY CAN_ATTACK
 BuildCost = 10
 BuildTime = 0
 Prerequisites
  Science = SCIENCE_GATE
 End
 Body = ActiveBody Body
  MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY ScienceRifle
 End
 Locomotor = SET_NORMAL ScienceWalk
End
)",R"(
    Weapon ScienceRifle
 PrimaryDamage = 100
 AttackRange = 100
 DelayBetweenShots = 100
End
)","Locomotor ScienceWalk\nSpeed = 200\nEnd","ScienceInfantry");
    BOOST_CHECK_THROW(generalszh::headless::RunDecodedMatch(unit,1,8),std::invalid_argument);
    generalszh::headless::ContentExercise blockedExercise;
    blockedExercise.unlockCatalog=&scienceCatalog;
    const auto blocked=generalszh::headless::RunDecodedMatch(unit,1,8,blockedExercise);
    BOOST_REQUIRE_EQUAL(blocked.buildReceipts.size(),1u);
    BOOST_CHECK(blocked.buildReceipts[0].status==generalszh::BuildAcceptance::PrerequisitesUnmet);
    BOOST_CHECK(blocked.unlockReceipts.empty());
    BOOST_CHECK(!blocked.attacker.IsValid());
    const std::array purchase{scienceKey};
    generalszh::headless::ContentExercise exercise;
    exercise.unlockCatalog=&scienceCatalog;
    exercise.purchaseUnlocks=std::span<const UnlockKey>{purchase};
    exercise.unlockCredits=3;
    const auto run=[&](const std::size_t workers) {
        return generalszh::headless::RunDecodedMatch(unit,workers,32,exercise);
    };
    const auto expected=run(1);
    BOOST_REQUIRE_EQUAL(expected.unlockReceipts.size(),1u);
    BOOST_CHECK(expected.unlockReceipts[0].result==UnlockResultCode::Purchased);
    BOOST_TEST(expected.unlockReceipts[0].key.value==purchase[0].value);
    BOOST_TEST(expected.unlockReceipts[0].creditsBefore==3u);
    BOOST_TEST(expected.unlockReceipts[0].creditsAfter==0u);
    BOOST_REQUIRE_EQUAL(expected.buildReceipts.size(),1u);
    BOOST_CHECK(expected.buildReceipts[0].status==generalszh::BuildAcceptance::Accepted);
    BOOST_CHECK(expected.attacker.IsValid());
    for (const auto workers:{2u,4u})
    {
        const auto actual=run(workers);
        BOOST_CHECK(actual.state==expected.state);
        BOOST_CHECK(actual.attacker==expected.attacker);
        BOOST_REQUIRE_EQUAL(actual.unlockReceipts.size(),1u);
        BOOST_CHECK(actual.unlockReceipts[0].result==UnlockResultCode::Purchased);
        BOOST_REQUIRE_EQUAL(actual.buildReceipts.size(),1u);
        BOOST_CHECK(actual.buildReceipts[0].status==generalszh::BuildAcceptance::Accepted);
        BOOST_TEST(actual.spawnTick==expected.spawnTick);
    }
    BOOST_TEST(scienceCatalog.SchemaHash()==scienceSchemaHash);
    BOOST_TEST(scienceCatalog.Find(scienceKey).value==scienceId.value);
}

BOOST_AUTO_TEST_CASE(decoded_cash_bounty_kill_settles_once_and_funds_followup_production_at_one_two_four_workers)
{
    using namespace engine::gameplay::rts::unlocks;
    const auto decodedBounty=generalszh::content::DecodeCashBountyDefinitions(R"(
Object CommandCenter
 Behavior = CashBountyPower ModuleTag_Bounty
  SpecialPowerTemplate = SpecialAbilityCashBounty3
  Bounty = 20%
 End
End
)",R"(
SpecialPower SpecialAbilityCashBounty3
 Enum = SPECIAL_CASH_BOUNTY
 RequiredScience = SCIENCE_CashBounty3
 PublicTimer = No
End
)","CommandCenter");
    const auto bountyDefinitions=generalszh::content::BindCashBountyDefinitions(decodedBounty);
    UnlockCatalog scienceCatalog;
    scienceCatalog.Register(UnlockDefinition{"SCIENCE_CashBounty3",1,1,true});
    scienceCatalog.Finalize();
    const auto scienceKey=MakeUnlockKey("SCIENCE_CashBounty3");
    const auto attacker=generalszh::content::DecodeUnit(R"(
Object BountyAttacker
 KindOf = INFANTRY CAN_ATTACK
 BuildCost = 20
 BuildTime = 0
 Body = ActiveBody Body
  MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY BountyGun
 End
 Locomotor = SET_NORMAL BountyWalk
End
)",R"(
Weapon BountyGun
 PrimaryDamage = 100
 AttackRange = 100
 DelayBetweenShots = 0
End
 )",R"(Locomotor BountyWalk
 Speed = 200
 End)","BountyAttacker");
    const auto victim=generalszh::content::DecodeUnit(R"(
Object BountyVictim
 KindOf = INFANTRY
 BuildCost = 100
 BuildTime = 0
 Body = ActiveBody Body
  MaxHealth = 100
 End
 Locomotor = SET_NORMAL BountyVictimWalk
End
 )","",R"(Locomotor BountyVictimWalk
 Speed = 200
 End)","BountyVictim");
    const std::array purchase{scienceKey};
    generalszh::headless::ContentExercise exercise;
    exercise.passiveTarget=&victim;
    exercise.unlockCatalog=&scienceCatalog;
    exercise.purchaseUnlocks=std::span<const UnlockKey>{purchase};
    exercise.unlockCredits=1;
    exercise.cashBountyDefinitions=std::span<const generalszh::bounty::CashBountyDefinition>{bountyDefinitions};
    exercise.cashBountyFollowupDefinition=attacker.definition.key;
    const auto run=[&](const std::size_t workers) {
        return generalszh::headless::RunDecodedMatch(attacker,workers,64,exercise);
    };
    const auto expected=run(1);
    BOOST_CHECK(expected.bountyRateNumerator==1u);
    BOOST_CHECK(expected.bountyRateDenominator==5u);
    BOOST_REQUIRE_EQUAL(expected.bountyAwards.size(),1u);
    BOOST_CHECK(expected.bountyAwards[0].source==expected.attacker);
    BOOST_CHECK(expected.bountyAwards[0].victim==expected.target);
    BOOST_CHECK(expected.bountyAwards[0].account==expected.attackerAccount);
    BOOST_CHECK(expected.bountyAwards[0].amount==20u);
    BOOST_CHECK(expected.attackerIncome==20u);
    BOOST_CHECK(expected.attackerBalance==0u);
    BOOST_CHECK(expected.bountyFollowupAccepted);
    BOOST_CHECK(expected.bountyFollowupSpawned);
    BOOST_REQUIRE(expected.bountyFollowupEntity.IsValid());
    BOOST_CHECK(expected.bountyFollowupEntity!=expected.attacker);
    BOOST_CHECK(expected.bountyFollowupDefinition==attacker.definition.key);
    BOOST_CHECK(expected.bountyFollowupAccount==expected.attackerAccount);
    for(const auto workers:{2u,4u})
    {
        const auto actual=run(workers);
        BOOST_CHECK(actual.state==expected.state);
        BOOST_CHECK(actual.attacker==expected.attacker);
        BOOST_CHECK(actual.target==expected.target);
        BOOST_REQUIRE_EQUAL(actual.bountyAwards.size(),1u);
        BOOST_CHECK(actual.bountyAwards[0].source==expected.bountyAwards[0].source);
        BOOST_CHECK(actual.bountyAwards[0].victim==expected.bountyAwards[0].victim);
        BOOST_CHECK(actual.bountyAwards[0].account==expected.bountyAwards[0].account);
        BOOST_CHECK(actual.bountyAwards[0].amount==20u);
        BOOST_CHECK(actual.attackerIncome==20u);
        BOOST_CHECK(actual.attackerBalance==0u);
        BOOST_CHECK(actual.bountyFollowupAccepted);
        BOOST_CHECK(actual.bountyFollowupSpawned);
        BOOST_REQUIRE(actual.bountyFollowupEntity.IsValid());
        BOOST_CHECK(actual.bountyFollowupEntity!=actual.attacker);
        BOOST_CHECK(actual.bountyFollowupEntity==expected.bountyFollowupEntity);
        BOOST_CHECK(actual.bountyFollowupDefinition==attacker.definition.key);
        BOOST_CHECK(actual.bountyFollowupDefinition==expected.bountyFollowupDefinition);
        BOOST_CHECK(actual.bountyFollowupAccount==expected.attackerAccount);
        BOOST_CHECK(actual.bountyFollowupAccount==expected.bountyFollowupAccount);
    }
}

BOOST_AUTO_TEST_CASE(decoded_cash_bounty_completed_building_pays_but_scaffold_does_not_at_one_two_four_workers)
{
    using namespace engine::gameplay::rts::unlocks;
    const auto decodedBounty=generalszh::content::DecodeCashBountyDefinitions(R"(
Object CommandCenter
 Behavior = CashBountyPower ModuleTag_Bounty
  SpecialPowerTemplate = SpecialAbilityCashBounty3
  Bounty = 20%
 End
End
)",R"(
SpecialPower SpecialAbilityCashBounty3
 Enum = SPECIAL_CASH_BOUNTY
 RequiredScience = SCIENCE_CashBounty3
 PublicTimer = No
End
)","CommandCenter");
    const auto bountyDefinitions=generalszh::content::BindCashBountyDefinitions(decodedBounty);
    UnlockCatalog scienceCatalog;
    scienceCatalog.Register(UnlockDefinition{"SCIENCE_CashBounty3",1,1,true});
    scienceCatalog.Finalize();
    const auto scienceKey=MakeUnlockKey("SCIENCE_CashBounty3");
    const auto attacker=generalszh::content::DecodeUnit(R"(
Object BuildingBountyAttacker
 KindOf = INFANTRY CAN_ATTACK
 BuildCost = 20
 BuildTime = 0
 Body = ActiveBody Body
  MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY BuildingBountyGun
 End
 Locomotor = SET_NORMAL BuildingBountyWalk
End
)",R"(
Weapon BuildingBountyGun
 PrimaryDamage = 100
 AttackRange = 100
 DelayBetweenShots = 0
End
 )",R"(Locomotor BuildingBountyWalk
 Speed = 200
 End)","BuildingBountyAttacker");
    const auto rules=generalszh::content::DecodeGameRules(R"(
GameData
 ValuePerSupplyBox = 75
 MinLowEnergyProductionSpeed = 0.5
 MaxLowEnergyProductionSpeed = 0.8
 LowEnergyPenaltyModifier = 1.0
End
)");
    const auto building=generalszh::content::DecodeBuilding(R"(
Object BountyCommandCenter
 KindOf = STRUCTURE
 BuildCost = 100
 BuildTime = 10
 Body = StructureBody Body
  MaxHealth = 100
 End
End
)","BountyCommandCenter",rules);
    const std::array purchase{scienceKey};
    const auto run=[&](const bool scaffold,const std::size_t workers) {
        generalszh::headless::ContentExercise exercise;
        exercise.passiveBuilding=&building;
        exercise.passiveBuildingUnderConstruction=scaffold;
        exercise.unlockCatalog=&scienceCatalog;
        exercise.purchaseUnlocks=std::span<const UnlockKey>{purchase};
        exercise.unlockCredits=1;
        exercise.cashBountyDefinitions=std::span<const generalszh::bounty::CashBountyDefinition>{bountyDefinitions};
        return generalszh::headless::RunDecodedMatch(attacker,workers,64,exercise);
    };
    const auto completed=run(false,1);
    BOOST_CHECK(completed.targetStructureComplete);
    BOOST_REQUIRE_EQUAL(completed.bountyAwards.size(),1u);
    BOOST_CHECK(completed.bountyAwards[0].victim==completed.target);
    BOOST_CHECK(completed.bountyAwards[0].account==completed.attackerAccount);
    BOOST_CHECK(completed.bountyAwards[0].amount==20u);
    BOOST_CHECK(completed.attackerIncome==20u);
    BOOST_CHECK(completed.attackerBalance==20u);
    const auto scaffold=run(true,1);
    BOOST_CHECK(!scaffold.targetStructureComplete);
    BOOST_CHECK(scaffold.target.IsValid());
    BOOST_CHECK(scaffold.targetHealth==0u);
    BOOST_CHECK(scaffold.bountyAwards.empty());
    BOOST_CHECK(scaffold.attackerIncome==0u);
    BOOST_CHECK(scaffold.attackerBalance==0u);
    for(const auto workers:{2u,4u})
    {
        const auto completedActual=run(false,workers);
        BOOST_CHECK(completedActual.state==completed.state);
        BOOST_CHECK(completedActual.attacker==completed.attacker);
        BOOST_CHECK(completedActual.target==completed.target);
        BOOST_CHECK(completedActual.targetStructureComplete);
        BOOST_REQUIRE_EQUAL(completedActual.bountyAwards.size(),1u);
        BOOST_CHECK(completedActual.bountyAwards[0].victim==completed.bountyAwards[0].victim);
        BOOST_CHECK(completedActual.bountyAwards[0].account==completed.bountyAwards[0].account);
        BOOST_CHECK(completedActual.bountyAwards[0].amount==20u);
        BOOST_CHECK(completedActual.attackerIncome==20u);
        BOOST_CHECK(completedActual.attackerBalance==20u);

        const auto scaffoldActual=run(true,workers);
        BOOST_CHECK(scaffoldActual.state==scaffold.state);
        BOOST_CHECK(scaffoldActual.attacker==scaffold.attacker);
        BOOST_CHECK(scaffoldActual.target==scaffold.target);
        BOOST_CHECK(!scaffoldActual.targetStructureComplete);
        BOOST_CHECK(scaffoldActual.targetHealth==0u);
        BOOST_CHECK(scaffoldActual.bountyAwards.empty());
        BOOST_CHECK(scaffoldActual.attackerIncome==0u);
        BOOST_CHECK(scaffoldActual.attackerBalance==0u);
    }
}

