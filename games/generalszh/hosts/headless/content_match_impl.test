 WeaponSet
  Weapon = PRIMARY PayloadGun
 End
 Locomotor = SET_NORMAL PayloadDrive
End
)",R"(
Weapon PayloadGun
 PrimaryDamage = 5
 AttackRange = 100
 DelayBetweenShots = 100
End
)","Locomotor PayloadDrive\nSpeed = 200\nEnd","PayloadCarrier");
    const auto passenger=generalszh::content::DecodeUnit(R"(
Object PayloadInfantry
 KindOf = INFANTRY
 TransportSlotCount = 1
 BuildCost = 1
 BuildTime = 0.1
 Body = ActiveBody Tag
  MaxHealth = 25
 End
 Locomotor = SET_NORMAL PayloadInfantryDrive
End
)","","Locomotor PayloadInfantryDrive\nSpeed = 200\nEnd","PayloadInfantry");
