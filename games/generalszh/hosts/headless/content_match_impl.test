BOOST_AUTO_TEST_CASE(decoded_unlimited_weapon_fires_through_production_and_shared_game_plan)
{
    const auto unit=generalszh::content::DecodeUnit(
        "Object Tank\nKindOf = VEHICLE TRANSPORT\nBehavior = TransportContain Transport\nSlots = 5\nAllowInsideKindOf = INFANTRY\nDamagePercentToUnits = 10%\nEnd\nBuildCost = 100\nBuildTime = 0.1\nBody = ActiveBody Tag\nMaxHealth = 100\nEnd\nWeaponSet\nWeapon = PRIMARY Cannon\nEnd\nLocomotor = SET_NORMAL Drive\nEnd",
        "Weapon Cannon\nPrimaryDamage = 10\nAttackRange = 100\nDelayBetweenShots = 100\nEnd",
        "Locomotor Drive\nSpeed = 200\nEnd","Tank");
    BOOST_REQUIRE(unit.transport);
    const auto expected=generalszh::headless::RunDecodedMatch(unit,1);
    BOOST_TEST(expected.transportPresent); BOOST_TEST(!expected.passengerPresent);
    BOOST_CHECK(expected.outcome.status==generalszh::MatchStatus::Won); BOOST_TEST(expected.targetHealth==0u);
    for(const auto workers:{2u,4u}) {
        const auto actual=generalszh::headless::RunDecodedMatch(unit,workers);
        BOOST_CHECK(actual.state==expected.state); BOOST_TEST(actual.outcome.tick==expected.outcome.tick);
        BOOST_CHECK(actual.attacker==expected.attacker); BOOST_TEST(actual.targetHealth==0u);
    }
}
BOOST_AUTO_TEST_CASE(decoded_unit_drives_real_build_pursuit_weapon_and_match_plans)
{
    const auto unit=generalszh::content::DecodeUnit(R"(
Object FixtureInfantry
 KindOf = INFANTRY CAN_ATTACK
 TransportSlotCount = 1
 Behavior = SpecialAbility Capture
  SpecialPowerTemplate = FixtureCapture
  UpdateModuleStartsAttack = Yes
  StartsPaused = Yes
 End
 Behavior = SpecialAbilityUpdate CaptureUpdate
  SpecialPowerTemplate = FixtureCapture
  PreparationTime = 1000
 End
 BuildCost = 100
 BuildTime = 0.1
 Body = ActiveBody Tag
  MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY FixtureRifle
 End
 Locomotor = SET_NORMAL FixtureLocomotor
End
)",R"(
Weapon FixtureRifle
 PrimaryDamage = 50
 AttackRange = 100
 ClipSize = 3
 DelayBetweenShots = 100
 ClipReloadTime = 700
End
)","Locomotor FixtureLocomotor\nSpeed = 200\nEnd","FixtureInfantry",{},
        "SpecialPower FixtureCapture\nEnum = SPECIAL_INFANTRY_CAPTURE_BUILDING\nReloadTime = 15000\nEnd\n",
        generalszh::content::CapturePermission::Allowed);
    const auto expected=generalszh::headless::RunDecodedMatch(unit,1);
    BOOST_CHECK(expected.outcome.status==generalszh::MatchStatus::Won); BOOST_TEST(expected.targetHealth==0u);
    BOOST_CHECK(!expected.progressionPresent); BOOST_CHECK(!expected.regenerationPresent);
    BOOST_TEST(expected.passengerPresent); BOOST_TEST(!expected.transportPresent);
    BOOST_TEST(expected.capturePresent); BOOST_TEST(!expected.captureEnabled);
    for(const auto workers:{2u,4u})
    {
        const auto actual=generalszh::headless::RunDecodedMatch(unit,workers);
        BOOST_CHECK(actual.state==expected.state); BOOST_CHECK(actual.outcome.winner==expected.outcome.winner);
        BOOST_TEST(actual.outcome.tick==expected.outcome.tick);
    }
}
BOOST_AUTO_TEST_CASE(decoded_capabilities_are_created_by_production_and_run_next_tick)
{
    // Authored self-heal fixture with the extracted Ranger XP thresholds. This
    // does not claim Ranger inherits active self-healing or that kills grant XP.
    const auto unit=generalszh::content::DecodeUnit(R"(
Object CapabilityFixture
 BuildCost = 100
 BuildTime = 0.1
 ExperienceValue = 20 20 40 60
 ExperienceRequired = 0 40 60 120
 IsTrainable = Yes
 Body = ActiveBody Tag
  MaxHealth = 100
  InitialHealth = 40
 End
 WeaponSet
  Weapon = PRIMARY FixtureRifle
 End
 Behavior = AutoHealBehavior Heal
  HealingAmount = 10
  HealingDelay = 100
  StartsActive = Yes
  Radius = 0
 End
 Locomotor = SET_NORMAL FixtureLocomotor
End
)",R"(
Weapon FixtureRifle
 PrimaryDamage = 5
 AttackRange = 100
 ClipSize = 3
 DelayBetweenShots = 100
 ClipReloadTime = 700
End
)","Locomotor FixtureLocomotor\nSpeed = 200\nEnd","CapabilityFixture");
    BOOST_REQUIRE(unit.progression); BOOST_REQUIRE(unit.regeneration);
    const auto run=[&](std::size_t workers) {
        return generalszh::headless::RunDecodedMatch(unit,workers,4096,{120,{}});
    };
    const auto expected=run(1);
    BOOST_CHECK(expected.outcome.status==generalszh::MatchStatus::Won);
    BOOST_REQUIRE(expected.progressionPresent); BOOST_REQUIRE(expected.regenerationPresent);
    BOOST_TEST(expected.spawnHealth==40000u); // No health work before spawn commit.
    BOOST_REQUIRE_GE(expected.state.size(),4u); BOOST_TEST(expected.state[3]==100000u);
    BOOST_TEST(expected.experience==120u); BOOST_TEST(expected.level==3u);
    BOOST_REQUIRE_EQUAL(expected.experienceResults.size(),1u);
    const auto &award=expected.experienceResults[0];
    BOOST_CHECK(award.entity==expected.attacker); BOOST_TEST(award.tick==expected.spawnTick+1);
    BOOST_TEST(award.requested==120u); BOOST_TEST(award.applied==120u);
    BOOST_TEST(award.oldLevel==0u); BOOST_TEST(award.newLevel==3u);
    BOOST_CHECK(award.outcome==engine::gameplay::progression::ExperienceOutcome::Applied);
    const auto results=[](const auto &report) {
        std::vector<std::array<std::uint64_t,9>> values;
        for(const auto &r:report.experienceResults) values.push_back({r.entity.index,r.entity.generation,r.tick,
            r.requested,r.applied,r.experience,r.oldLevel,r.newLevel,static_cast<std::uint64_t>(r.outcome)});
        return values;
    };
    for(const auto workers:{2u,4u}) {
        const auto actual=run(workers);
        BOOST_CHECK(actual.state==expected.state); BOOST_CHECK(results(actual)==results(expected));
        BOOST_CHECK(actual.outcome.winner==expected.outcome.winner); BOOST_TEST(actual.outcome.tick==expected.outcome.tick);
        BOOST_TEST(actual.targetHealth==expected.targetHealth);
    }
    auto inactive=unit; inactive.regeneration->startsActive=false;
    const auto inactiveReport=generalszh::headless::RunDecodedMatch(inactive,1);
    BOOST_REQUIRE(inactiveReport.regenerationPresent);
    BOOST_REQUIRE_GE(inactiveReport.state.size(),4u); BOOST_TEST(inactiveReport.state[3]==40000u);
    BOOST_TEST(inactiveReport.experience==0u); BOOST_TEST(inactiveReport.experienceResults.empty());
}

BOOST_AUTO_TEST_CASE(real_projectile_kill_awards_a_nontrainable_victim_value_at_one_two_four_workers)
{
    const auto attacker=generalszh::content::DecodeUnit(R"(
Object XPAttacker
 KindOf = INFANTRY CAN_ATTACK
 BuildCost = 1
 BuildTime = 0
 ExperienceValue = 0 0 0 0
 ExperienceRequired = 0 10 20 30
 IsTrainable = Yes
 Body = ActiveBody Body
  MaxHealth = 100
 End
 WeaponSet
  Weapon = PRIMARY XPWeapon
 End
 Locomotor = SET_NORMAL Walk
End
)",R"(
Weapon XPWeapon
 PrimaryDamage = 100
 AttackRange = 100
 DelayBetweenShots = 100
End
)","Locomotor Walk\nSpeed = 200\nEnd","XPAttacker");
    const auto victim=generalszh::content::DecodeUnit(R"(
Object XPVictim
 KindOf = INFANTRY
 BuildCost = 1
 BuildTime = 0
 ExperienceValue = 37 37 37 37
 ExperienceRequired = 0 100 200 300
 IsTrainable = No
 Body = ActiveBody Body
  MaxHealth = 100
 End
 Locomotor = SET_NORMAL Walk
End
)","","Locomotor Walk\nSpeed = 200\nEnd","XPVictim");
    BOOST_REQUIRE(attacker.progression); BOOST_REQUIRE(victim.progression);
    generalszh::headless::ContentExercise exercise; exercise.passiveTarget=&victim;
    const auto run=[&](const std::size_t workers) {
        return generalszh::headless::RunDecodedMatch(attacker,workers,64,exercise);
    };
    const auto expected=run(1);
    BOOST_CHECK(expected.outcome.status==generalszh::MatchStatus::Running);
    BOOST_TEST(expected.targetHealth==0u); BOOST_REQUIRE_EQUAL(expected.experienceResults.size(),1u);
    BOOST_REQUIRE_EQUAL(expected.acceptedHits.size(),1u);
    BOOST_CHECK(expected.acceptedHits[0].packet.attribution.source==expected.attacker);
    BOOST_CHECK(expected.acceptedHits[0].packet.attribution.sourceAccount==expected.attackerAccount);
    const auto &award=expected.experienceResults[0];
    BOOST_CHECK(award.entity==expected.attacker); BOOST_TEST(award.requested==37u);
    BOOST_TEST(award.applied==37u); BOOST_TEST(expected.experience==37u);
    for(const auto workers:{2u,4u})
    {
        const auto actual=run(workers);
        BOOST_CHECK(actual.state==expected.state);
        BOOST_CHECK(actual.experienceResults.size()==expected.experienceResults.size());
        BOOST_CHECK(actual.experienceResults[0].entity==expected.experienceResults[0].entity);
        BOOST_TEST(actual.experienceResults[0].tick==expected.experienceResults[0].tick);
        BOOST_TEST(actual.experienceResults[0].requested==37u);
        BOOST_TEST(actual.experienceResults[0].applied==37u);
        BOOST_TEST(actual.targetHealth==0u); BOOST_TEST(actual.outcome.tick==expected.outcome.tick);
    }
}

BOOST_AUTO_TEST_CASE(decoded_dozer_repair_authoring_binds_once_and_is_born_through_production)
{
    using namespace std::chrono_literals;
    const auto unit=generalszh::content::DecodeUnit(R"(
Object RepairDozer
 BuildCost = 1
 BuildTime = 0
 Body = ActiveBody Tag
  MaxHealth = 100
 End
 Behavior = DozerAIUpdate Repair
  RepairHealthPercentPerSecond = 2%
 End
 WeaponSet
  Weapon = PRIMARY RepairGun
 End
 Locomotor = SET_NORMAL RepairLocomotor
End
)",R"(
Weapon RepairGun
 PrimaryDamage = 1
 AttackRange = 100
 DelayBetweenShots = 100
End
)","Locomotor RepairLocomotor\nSpeed = 200\nEnd","RepairDozer");
    BOOST_REQUIRE(unit.definition.manualRepair);
    BOOST_TEST(unit.definition.manualRepair->interval==1s);
    BOOST_CHECK(unit.definition.manualRepair->intervalPolicy==
        engine::gameplay::rts::repair::RepairIntervalPolicy::SimulationStep);
    const auto expected=generalszh::headless::RunDecodedMatch(unit,1,32);
    BOOST_REQUIRE(expected.manualRepairPresent);
    for(const auto workers:{2u,4u})
    {
        const auto actual=generalszh::headless::RunDecodedMatch(unit,workers,32);
        BOOST_CHECK(actual.manualRepairPresent);
        BOOST_CHECK(actual.state==expected.state);
        BOOST_TEST(actual.spawnTick==expected.spawnTick);
    }
}
BOOST_AUTO_TEST_CASE(extracted_ranger_is_deterministic, *boost::unit_test::disabled())
{
    const auto &arguments=boost::unit_test::framework::master_test_suite(); BOOST_REQUIRE(arguments.argc==2);
    const std::filesystem::path root(arguments.argv[1]);
    const auto expected=generalszh::headless::RunContentMatch(root,1);
    BOOST_TEST(expected.unitName=="AmericaInfantryRanger"); BOOST_CHECK(expected.match.outcome.status==generalszh::MatchStatus::Won);
    BOOST_CHECK(expected.match.progressionPresent);
    BOOST_CHECK(expected.match.passengerPresent); BOOST_CHECK(!expected.match.transportPresent);
    BOOST_CHECK(expected.match.capturePresent); BOOST_CHECK(!expected.match.captureEnabled); // StartsPaused does not grant the upgrade.
    BOOST_CHECK(expected.match.armorPresent);BOOST_REQUIRE(!expected.match.acceptedHits.empty());
    BOOST_TEST(expected.match.acceptedHits[0].packet.type.value==3u); // Ranger SMALL_ARMS, not generic default type 0.
    BOOST_CHECK(!expected.match.regenerationPresent); // Only explicit Object fields are resolved.
    for(const auto workers:{2u,4u})
    {
        const auto actual=generalszh::headless::RunContentMatch(root,workers);
        BOOST_CHECK(actual.match.state==expected.match.state); BOOST_CHECK(actual.match.outcome.winner==expected.match.outcome.winner);
        BOOST_TEST(actual.match.outcome.tick==expected.match.outcome.tick); BOOST_TEST(actual.match.targetHealth==expected.match.targetHealth);
    }
}

BOOST_AUTO_TEST_CASE(production_created_content_armor_resolves_real_hits_and_preserves_provenance_across_workers)
{
    using namespace generalszh::content;
    const std::string armor="Armor HumanArmor\nArmor = ARMOR_PIERCING 10%\nArmor = FLAME 150%\nEnd\nArmor NoArmor\nArmor = DEFAULT 100%\nEnd\n";
    const std::string locomotor="Locomotor Walk\nSpeed = 200\nEnd";
    auto attacker=DecodeUnit("Object ArmorAttacker\nBuildCost = 10\nBuildTime = 0.1\nBody = ActiveBody B\nMaxHealth = 100\nEnd\nWeaponSet\nWeapon = PRIMARY Gun\nEnd\nArmorSet\nArmor = NoArmor\nEnd\nLocomotor = SET_NORMAL Walk\nEnd",
        "Weapon Gun\nPrimaryDamage = 10\nDamageType = ARMOR_PIERCING\nAttackRange = 100\nDelayBetweenShots = 100\nEnd",
        locomotor,"ArmorAttacker",{},"",CapturePermission::Unresolved,armor);
    const auto target=DecodeUnit("Object ArmorTarget\nBuildCost = 10\nBuildTime = 0.1\nBody = ActiveBody B\nMaxHealth = 100\nEnd\nArmorSet\nConditions = None\nArmor = HumanArmor\nEnd\nLocomotor = SET_NORMAL Walk\nEnd",
        "",locomotor,"ArmorTarget",{},"",CapturePermission::Unresolved,armor);
    // Explicit host-authored channel, not inferred from DamageType or INI order.
    attacker.definition.weapon.damageChannel={17};
    generalszh::headless::ContentExercise exercise;exercise.passiveTarget=&target;exercise.hitCapacity=512;
    const auto run=[&](unsigned workers){return generalszh::headless::RunDecodedMatch(attacker,workers,1024,exercise);};
    const auto expected=run(1);BOOST_TEST(expected.armorPresent);BOOST_TEST(expected.targetArmorPresent);
    BOOST_TEST(expected.targetHealth==0u);BOOST_REQUIRE(!expected.acceptedHits.empty());
    for(const auto &hit:expected.acceptedHits) {
        BOOST_CHECK(hit.target==expected.target);BOOST_CHECK(hit.packet.attribution.source==expected.attacker);
        BOOST_CHECK(hit.packet.attribution.sourceAccount==expected.attackerAccount);
        BOOST_TEST(hit.packet.attribution.sourceDefinition==attacker.definition.key);
        BOOST_TEST(hit.packet.type.value==2u);BOOST_TEST(hit.packet.channel.value==17u);
        BOOST_TEST(hit.packet.quantity==10000u);BOOST_TEST(hit.resolvedQuantity==1000u);BOOST_TEST(!hit.saturated);
    }
    const auto snapshot=[](const auto &report) {
        std::vector<std::uint64_t> result;
        for(const auto &hit:report.acceptedHits) result.insert(result.end(),{
            hit.target.index,hit.target.generation,hit.projectile.index,hit.projectile.generation,hit.launchTick,hit.impactTick,
            hit.packet.type.value,hit.packet.channel.value,hit.packet.quantity,hit.packet.attribution.source.index,
            hit.packet.attribution.source.generation,hit.packet.attribution.sourceAccount.index,
            hit.packet.attribution.sourceAccount.generation,hit.packet.attribution.sourceDefinition,hit.resolvedQuantity,hit.saturated});
        return result;
    };
    for(const auto workers:{2u,4u}) {
        const auto actual=run(workers);BOOST_CHECK(actual.state==expected.state);
        BOOST_CHECK(actual.attacker==expected.attacker);BOOST_CHECK(actual.target==expected.target);
        BOOST_CHECK(snapshot(actual)==snapshot(expected));
    }
    auto wrong=target;wrong.damagePolicies[2].armor=engine::gameplay::combat::damage::ArmorApplication::Bypass;
    exercise.passiveTarget=&wrong;
    BOOST_CHECK_THROW(run(1),std::invalid_argument);
    exercise.passiveTarget=&target;exercise.hitCapacity=1;
    BOOST_CHECK_THROW(run(1),std::length_error);
}

