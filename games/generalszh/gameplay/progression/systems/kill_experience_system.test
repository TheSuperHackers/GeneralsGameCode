BOOST_AUTO_TEST_CASE(kill_award_rejects_reused_source_and_target_generation_proofs)
{
    ecs::World world; RegisterComponents(world);
    const auto killerAccount=world.Create(); const auto victimAccount=world.Create();
    const auto match=BeginMatch(world,killerAccount,victimAccount);
    const auto oldKiller=world.Create<LifeState,ProgressionState,ProgressionDefinitionRef,ProgressionEligibility,
        ProgressionInbox,ProducedUnit>();
    const auto victim=world.Create<LifeState,DamageResult,VeterancyAwardBinding,ProducedUnit>();
    *world.Get<ProducedUnit>(oldKiller)={killerAccount,killerAccount,0}; *world.Get<ProducedUnit>(victim)={victimAccount,victimAccount,1};
    *world.Get<ProgressionEligibility>(oldKiller)={true}; *world.Get<ProgressionDefinitionRef>(oldKiller)={0};
    *world.Get<VeterancyAwardBinding>(victim)={0,true};
    const auto proofKiller=oldKiller; world.Destroy(oldKiller); const auto replacement=world.Create();
    BOOST_REQUIRE_EQUAL(replacement.index,proofKiller.index); BOOST_REQUIRE(replacement.generation!=proofKiller.generation);
    *world.Get<LifeState>(victim)={false};
    *world.Get<DamageResult>(victim)={100,true,{victim,proofKiller,killerAccount,1,100,0,100,true}};
    const std::array definitions{VeterancyDefinition{{0,100,200,300},{25,25,25,25},true}};
    const VeterancyCatalog veterancyCatalog(definitions); ProgressionBatch batch(2); batch.SetInputs({});
    const std::array progressionDefinitions{definitions[0].Progression()};
    const engine::gameplay::progression::ProgressionCatalog progressionCatalog(progressionDefinitions);
    engine::gameplay::progression::ProgressionSystem progression(progressionCatalog,batch);
    KillExperienceSystem system(world,match,progressionCatalog,veterancyCatalog,batch,32,2); system.Configure();
    HealthSystem healthSystem; ecs::SystemRegistry registry; registry.Register(healthSystem);
    registry.Register(system); registry.Register(progression); registry.Finalize(world.Components());
    ecs::Scheduler scheduler(world,registry,engine::jobs::JobSystemConfig{1}); const engine::time::FixedStep step{30}; scheduler.Finalize(step);
    scheduler.Execute({1,step}); BOOST_TEST(batch.Results().empty());
}

BOOST_AUTO_TEST_CASE(kill_award_append_is_once_only_for_a_published_damage_result)
{
    ecs::World world; RegisterComponents(world);
    const auto killerAccount=world.Create(); const auto victimAccount=world.Create();
    const auto match=BeginMatch(world,killerAccount,victimAccount);
    const auto killer=world.Create<LifeState,ProgressionState,ProgressionDefinitionRef,ProgressionEligibility,
        ProgressionInbox,ProducedUnit>();
    const auto victim=world.Create<LifeState,DamageResult,VeterancyAwardBinding,ProducedUnit>();
    *world.Get<ProducedUnit>(killer)={killerAccount,killerAccount,0}; *world.Get<ProducedUnit>(victim)={victimAccount,victimAccount,1};
    *world.Get<ProgressionEligibility>(killer)={true}; *world.Get<ProgressionDefinitionRef>(killer)={0};
    *world.Get<VeterancyAwardBinding>(victim)={0,true};
    *world.Get<LifeState>(victim)={false}; *world.Get<DamageResult>(victim)={100,true,{victim,killer,killerAccount,2,100,0,100,true}};
    const std::array definitions{VeterancyDefinition{{0,100,200,300},{10,10,10,10},true}};
    const VeterancyCatalog veterancyCatalog(definitions); ProgressionBatch batch(2); batch.SetInputs({});
    const std::array progressionDefinitions{definitions[0].Progression()};
    const engine::gameplay::progression::ProgressionCatalog progressionCatalog(progressionDefinitions);
    engine::gameplay::progression::ProgressionSystem progression(progressionCatalog,batch);
    KillExperienceSystem system(world,match,progressionCatalog,veterancyCatalog,batch,32,2); system.Configure();
    HealthSystem healthSystem; ecs::SystemRegistry registry; registry.Register(healthSystem);
    registry.Register(system); registry.Register(progression); registry.Finalize(world.Components());
    ecs::Scheduler scheduler(world,registry,engine::jobs::JobSystemConfig{2}); const engine::time::FixedStep step{30}; scheduler.Finalize(step);
    scheduler.Execute({2,step});
    BOOST_REQUIRE_EQUAL(batch.Results().size(),1u); BOOST_TEST(batch.Results()[0].applied==10u);
    *world.Get<DamageResult>(victim)={}; batch.SetInputs({}); scheduler.Execute({3,step}); BOOST_TEST(batch.Results().empty());
}
