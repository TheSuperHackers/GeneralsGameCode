#define BOOST_TEST_MODULE GeneralsZHVictoryAsset
#include <boost/test/included/unit_test.hpp>
#include <cstdint>
#include <string_view>
#include <type_traits>
import games.generalszh.gameplay.match.components.victory_asset;

BOOST_AUTO_TEST_CASE(victory_asset_metadata_is_stable_and_serializable)
{
    using Component = generalszh::match::VictoryAsset;
    static_assert(std::is_standard_layout_v<Component>);
    static_assert(std::is_trivially_copyable_v<Component>);
    static_assert(ecs::ComponentTraits<Component>::StableName
        == std::string_view{"games.generalszh.match.victory_asset"});
    static_assert(ecs::ComponentTraits<Component>::Version == 1u);
    static_assert(ecs::ComponentTraits<Component>::Persistence
        == ecs::PersistencePolicy::Serializable);

    BOOST_TEST(ecs::ComponentTraits<Component>::StableName
        == "games.generalszh.match.victory_asset");
    BOOST_TEST(ecs::ComponentTraits<Component>::Version == 1u);
    BOOST_CHECK(ecs::ComponentTraits<Component>::Persistence
        == ecs::PersistencePolicy::Serializable);

    ecs::ComponentRegistry registry;
    BOOST_TEST(registry.Register<Component>() == ecs::InvalidComponentId);
    registry.Finalize();
    const auto id = registry.TryGet<Component>();
    const auto &info = registry.Get(id);
    BOOST_TEST(info.stableKey == ecs::HashComponentKey(ecs::ComponentTraits<Component>::StableName));
    BOOST_TEST(info.stableName == ecs::ComponentTraits<Component>::StableName);
    BOOST_TEST(info.version == 1u);
    BOOST_CHECK(info.persistence == ecs::PersistencePolicy::Serializable);
    BOOST_TEST(info.size == sizeof(Component));
    BOOST_TEST(info.alignment == alignof(Component));
}
