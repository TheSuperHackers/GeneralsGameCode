#include <boost/test/unit_test.hpp>
#include <array>
#include <stdexcept>

import games.generalszh.gameplay.crates.inputs.crate_pickup_batch;
import games.generalszh.gameplay.crates.inputs.crate_reward_batch;

namespace crates = generalszh::crates;

BOOST_AUTO_TEST_CASE(crate_batch_copies_bounded_contact_and_progression_prefix)
{
	crates::CratePickupBatch batch(2, 4);
	const std::array inputs{crates::CratePickupInput{{4, 1}, {8, 1}, 3}};
	const std::array prefix{engine::gameplay::progression::AcceptedExperience{{8, 1}, 12}};
	batch.SetInputs(inputs); batch.SetProgressionPrefix(prefix);
	BOOST_TEST(batch.Inputs().size() == 1u);
	BOOST_TEST(batch.Inputs()[0].collector.index == 8u);
	BOOST_TEST(batch.ProgressionPrefix()[0].amount == 12u);
	BOOST_CHECK_THROW(batch.SetInputs(std::array{inputs[0], inputs[0], inputs[0]}), std::length_error);
}

BOOST_AUTO_TEST_CASE(crate_reward_publication_requires_explicit_release)
{
	crates::CrateRewardBatch batch(2);
	const std::array request{generalszh::economy::AccountRequest{
		{3, 1}, {generalszh::economy::AccountOperation::Deposit, 20, false, false}}};
	const std::array crate{ecs::Entity{4, 1}};
	batch.Publish(request, crate);
	BOOST_CHECK(batch.IsPublished());
	BOOST_TEST(batch.Requests()[0].command.amount == 20u);
	BOOST_CHECK_THROW(batch.Publish({}, {}), std::logic_error);
	batch.Release();
	BOOST_CHECK(!batch.IsPublished());
}
