#define BOOST_TEST_MODULE GeneralsZHBuildAdmission
#include <boost/test/included/unit_test.hpp>
#include <type_traits>
import games.generalszh.gameplay.production.components.build_admission;

BOOST_AUTO_TEST_CASE(build_admission_is_a_transient_component_with_stable_schema)
{
    static_assert(std::is_trivially_copyable_v<generalszh::production::BuildAdmission>);
    BOOST_TEST(ecs::ComponentTraits<generalszh::production::BuildAdmission>::StableName
        == "games.generalszh.production.admission");
    BOOST_TEST(ecs::ComponentTraits<generalszh::production::BuildAdmission>::Version == 1u);
    BOOST_CHECK(ecs::ComponentTraits<generalszh::production::BuildAdmission>::Persistence
        == ecs::PersistencePolicy::Transient);
}
