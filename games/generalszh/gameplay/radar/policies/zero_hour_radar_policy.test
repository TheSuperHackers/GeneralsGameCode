#define BOOST_TEST_MODULE GeneralsZHRadarZeroHourPolicy
#include <boost/test/included/unit_test.hpp>

#include <array>
#include <cstddef>
#include <cstdint>
#include <memory_resource>
#include <vector>

import engine.ecs.scheduler.scheduler;
import engine.events.storage.event_batch;
import engine.gameplay.combat.components.health;
import engine.gameplay.rts.power.components.power_ledger;
import engine.gameplay.rts.power.components.power_source;
import engine.gameplay.rts.radar.components.radar_availability;
import engine.gameplay.rts.radar.components.radar_provider_contribution;
