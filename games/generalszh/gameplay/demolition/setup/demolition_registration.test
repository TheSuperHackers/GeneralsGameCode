#define BOOST_TEST_MODULE GeneralsZHDemolitionRegistration
#include <boost/test/included/unit_test.hpp>
#include <cstddef>
#include <cstdint>
#include <string_view>
import engine.ecs.query.query;
import engine.ecs.core.world;
import engine.gameplay.combat.death.components.death_weapon_state;
import games.generalszh.gameplay.demolition.components.demolition_trap;
import games.generalszh.gameplay.demolition.setup.demolition_registration;

BOOST_AUTO_TEST_CASE(demolition_registration_freezes_stable_components_and_supports_query)
{
    using namespace engine::gameplay::combat::death;
    using namespace generalszh::demolition;
    ecs::World world;
    RegisterDemolitionComponents(world);
    BOOST_CHECK(!world.Components().IsFrozen());

    world.FinalizeComponents();
    const auto bindingId=world.Components().TryGet<DeathWeaponBinding>();
    const auto deathStateId=world.Components().TryGet<DeathWeaponState>();
    const auto trapStateId=world.Components().TryGet<DemolitionTrapState>();
    const auto classificationId=world.Components().TryGet<DemolitionTargetClassification>();
    BOOST_REQUIRE(bindingId!=ecs::InvalidComponentId);
    BOOST_REQUIRE(deathStateId!=ecs::InvalidComponentId);
    BOOST_REQUIRE(trapStateId!=ecs::InvalidComponentId);
    BOOST_REQUIRE(classificationId!=ecs::InvalidComponentId);
    const auto schema=world.Components().SchemaHash();
    BOOST_CHECK(schema!=ecs::UnfinalizedSchemaHash);

    const auto &bindingInfo=world.Components().Get(bindingId);
    const auto &deathStateInfo=world.Components().Get(deathStateId);
    const auto &trapStateInfo=world.Components().Get(trapStateId);
    const auto &classificationInfo=world.Components().Get(classificationId);
    BOOST_TEST(bindingInfo.stableName==std::string_view{"engine.gameplay.combat.death_weapon_binding"});
    BOOST_TEST(deathStateInfo.stableName==std::string_view{"engine.gameplay.combat.death_weapon_state"});
    BOOST_TEST(trapStateInfo.stableName==std::string_view{"games.generalszh.demolition.trap_state"});
    BOOST_TEST(classificationInfo.stableName==std::string_view{"games.generalszh.demolition.target_classification"});
    BOOST_TEST(bindingInfo.version==1u);
    BOOST_TEST(deathStateInfo.version==1u);
    BOOST_TEST(trapStateInfo.version==1u);
    BOOST_TEST(classificationInfo.version==1u);
    BOOST_CHECK(bindingInfo.persistence==ecs::PersistencePolicy::Serializable);
    BOOST_CHECK(deathStateInfo.persistence==ecs::PersistencePolicy::Serializable);
    BOOST_CHECK(trapStateInfo.persistence==ecs::PersistencePolicy::Serializable);
    BOOST_CHECK(classificationInfo.persistence==ecs::PersistencePolicy::Transient);

    world.FinalizeComponents();
    BOOST_TEST(world.Components().TryGet<DeathWeaponBinding>()==bindingId);
    BOOST_TEST(world.Components().TryGet<DeathWeaponState>()==deathStateId);
    BOOST_TEST(world.Components().TryGet<DemolitionTrapState>()==trapStateId);
    BOOST_TEST(world.Components().TryGet<DemolitionTargetClassification>()==classificationId);
    BOOST_TEST(world.Components().SchemaHash()==schema);

    const auto entity=world.Create<DeathWeaponBinding,DeathWeaponState,
        DemolitionTrapState,DemolitionTargetClassification>();
    world.Get<DeathWeaponBinding>(entity)->definition=23;
    world.Get<DeathWeaponState>(entity)->armed=true;
    world.Get<DemolitionTrapState>(entity)->mode=DemolitionDetonationMode::Manual;
    world.Get<DemolitionTargetClassification>(entity)->unattackable=true;

    ecs::Query<ecs::Read<DeathWeaponBinding>,ecs::Read<DeathWeaponState>,
        ecs::Read<DemolitionTrapState>,ecs::Read<DemolitionTargetClassification>> query(world);
    std::size_t count=0;
    query.ForEachChunk([&](auto chunk)
    {
        const auto bindings=chunk.template Get<DeathWeaponBinding>();
        const auto deathStates=chunk.template Get<DeathWeaponState>();
        const auto trapStates=chunk.template Get<DemolitionTrapState>();
        const auto classifications=chunk.template Get<DemolitionTargetClassification>();
        for(std::size_t row=0;row!=chunk.Count();++row)
        {
            ++count;
            BOOST_TEST(bindings[row].definition==23u);
            BOOST_CHECK(deathStates[row].armed);
            BOOST_CHECK(trapStates[row].mode==DemolitionDetonationMode::Manual);
            BOOST_CHECK(classifications[row].unattackable);
        }
    });
    BOOST_TEST(count==1u);
}
