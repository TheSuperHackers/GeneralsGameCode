#define BOOST_TEST_MODULE GeneralsZHProductionPresentationDefinitionAdapter
#include <boost/test/included/unit_test.hpp>

#include "presentation_definition.h"
#include <array>
#include <cstdint>
#include <limits>
#include <stdexcept>
#include <type_traits>
#include <utility>

import engine.time.simulation_time;
import games.generalszh.adapters.legacy.production.definitions.presentation_definition;
import games.generalszh.gameplay.production.definitions.presentation_definition;

using generalszh::legacy::ProductionPresentationDefinition;
using ModernProductionPresentationDefinition =
	generalszh::production::ProductionPresentationDefinition;
using engine::time::Duration;
using engine::time::FixedStep;

static_assert(!std::is_default_constructible_v<ProductionPresentationDefinition>);
static_assert(!std::is_copy_constructible_v<ProductionPresentationDefinition>);
static_assert(!std::is_move_constructible_v<ProductionPresentationDefinition>);
static_assert(!std::is_copy_assignable_v<ProductionPresentationDefinition>);
static_assert(!std::is_move_assignable_v<ProductionPresentationDefinition>);

static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.NumDoorAnimations()));
static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.DoorOpeningTicks()));
static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.DoorWaitingTicks()));
static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.DoorClosingTicks()));
static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.ConstructionCompleteTicks()));
static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.TicksPerSecond()));
static_assert(noexcept(std::declval<const ProductionPresentationDefinition &>()
	.Fingerprint()));

namespace presentation_definition_test
{
constexpr std::uint64_t NanosPerSecond = 1'000'000'000;

Duration RepresentativeDuration(const std::uint32_t ticks,
	const std::uint32_t ticksPerSecond)
{
	return Duration{static_cast<Duration::rep>(
		(static_cast<std::uint64_t>(ticks) * NanosPerSecond) / ticksPerSecond)};
}
}

using namespace presentation_definition_test;

BOOST_AUTO_TEST_CASE(zero_and_signed_animation_values_are_preserved)
{
	const ProductionPresentationDefinition zero{-7, 0, 0, 0, 0, 30};
	BOOST_TEST(zero.NumDoorAnimations() == -7);
	BOOST_TEST(zero.DoorOpeningTicks() == 0u);
	BOOST_TEST(zero.DoorWaitingTicks() == 0u);
	BOOST_TEST(zero.DoorClosingTicks() == 0u);
	BOOST_TEST(zero.ConstructionCompleteTicks() == 0u);
	BOOST_TEST(zero.TicksPerSecond() == 30u);

	const ProductionPresentationDefinition maximumAnimations{
		(std::numeric_limits<std::int32_t>::max)(), 0, 0, 0, 0, 60};
	BOOST_TEST(maximumAnimations.NumDoorAnimations() ==
		(std::numeric_limits<std::int32_t>::max)());

	const ProductionPresentationDefinition minimumAnimations{
		(std::numeric_limits<std::int32_t>::min)(), 0, 0, 0, 0, 60};
	BOOST_TEST(minimumAnimations.NumDoorAnimations() ==
		(std::numeric_limits<std::int32_t>::min)());
}

BOOST_AUTO_TEST_CASE(all_legacy_tick_values_round_trip_at_supported_rates)
{
	constexpr auto maximum = (std::numeric_limits<std::uint32_t>::max)();
	constexpr std::array rates{1u, 30u, 60u, 1'000'000'000u};
	constexpr std::array values{0u, 1u, 2u, 29u, 30u, 31u, 59u, 60u, 61u, maximum};

	for (const auto rate : rates)
	{
		for (const auto value : values)
		{
			const ProductionPresentationDefinition definition{
				-11, value, value, value, value, rate};
			BOOST_TEST(definition.DoorOpeningTicks() == value);
			BOOST_TEST(definition.DoorWaitingTicks() == value);
			BOOST_TEST(definition.DoorClosingTicks() == value);
			BOOST_TEST(definition.ConstructionCompleteTicks() == value);
			BOOST_TEST(definition.TicksPerSecond() == rate);
		}
	}
}

BOOST_AUTO_TEST_CASE(mixed_timings_round_trip_without_tick_mirrors)
{
	constexpr std::array rates{1u, 30u, 60u, 1'000'000'000u};
	constexpr auto maximum = (std::numeric_limits<std::uint32_t>::max)();
	constexpr std::array ticks{1u, 29u, 31u, 59u};

	for (const auto rate : rates)
	{
		const ProductionPresentationDefinition definition{
			-123, ticks[0], ticks[1], ticks[2], maximum, rate};
		BOOST_TEST(definition.NumDoorAnimations() == -123);
		BOOST_TEST(definition.DoorOpeningTicks() == ticks[0]);
		BOOST_TEST(definition.DoorWaitingTicks() == ticks[1]);
		BOOST_TEST(definition.DoorClosingTicks() == ticks[2]);
		BOOST_TEST(definition.ConstructionCompleteTicks() == maximum);
	}
}

BOOST_AUTO_TEST_CASE(invalid_adapter_rates_are_rejected_at_construction)
{
	BOOST_CHECK_THROW((ProductionPresentationDefinition{0, 0, 0, 0, 0, 0}),
		std::invalid_argument);
	BOOST_CHECK_THROW((ProductionPresentationDefinition{
		0, 0, 0, 0, 0, 1'000'000'001u}), std::invalid_argument);
}

BOOST_AUTO_TEST_CASE(adapter_matches_modern_definition_from_independent_conversion)
{
	constexpr std::int32_t animations = -42;
	constexpr std::array<std::uint32_t, 4> ticks{1u, 30u, 59u, 0xffff'ffffu};
	constexpr std::uint32_t rate = 60;

	const ProductionPresentationDefinition legacy{
		animations, ticks[0], ticks[1], ticks[2], ticks[3], rate};
	const ModernProductionPresentationDefinition modern{
		animations,
		RepresentativeDuration(ticks[0], rate),
		RepresentativeDuration(ticks[1], rate),
		RepresentativeDuration(ticks[2], rate),
		RepresentativeDuration(ticks[3], rate),
		FixedStep{rate}};

	BOOST_TEST(legacy.NumDoorAnimations() == modern.NumDoorAnimations());
	BOOST_TEST(legacy.DoorOpeningTicks() == modern.Doors().opening);
	BOOST_TEST(legacy.DoorWaitingTicks() == modern.Doors().waiting);
	BOOST_TEST(legacy.DoorClosingTicks() == modern.Doors().closing);
	BOOST_TEST(legacy.ConstructionCompleteTicks() == modern.Marker().duration);
	BOOST_TEST(legacy.TicksPerSecond() == modern.Step().TicksPerSecond());
	BOOST_TEST(legacy.Fingerprint() == modern.Fingerprint());
}

BOOST_AUTO_TEST_CASE(fingerprint_includes_rate_settings_and_signed_animation_count)
{
	const ProductionPresentationDefinition baseline{3, 1, 2, 29, 30, 60};
	const auto fingerprint = baseline.Fingerprint();

	BOOST_TEST((ProductionPresentationDefinition{3, 1, 2, 29, 30, 30}.Fingerprint() !=
		fingerprint));
	BOOST_TEST((ProductionPresentationDefinition{3, 2, 2, 29, 30, 60}.Fingerprint() !=
		fingerprint));
	BOOST_TEST((ProductionPresentationDefinition{3, 1, 3, 29, 30, 60}.Fingerprint() !=
		fingerprint));
	BOOST_TEST((ProductionPresentationDefinition{3, 1, 2, 30, 30, 60}.Fingerprint() !=
		fingerprint));
	BOOST_TEST((ProductionPresentationDefinition{3, 1, 2, 29, 31, 60}.Fingerprint() !=
		fingerprint));
	BOOST_TEST((ProductionPresentationDefinition{-3, 1, 2, 29, 30, 60}.Fingerprint() !=
		fingerprint));
}
