BOOST_AUTO_TEST_CASE(unit_self_heal_decodes_typed_data_and_reports_unsupported_policy)
{
    const std::string prefix="Object Healer\nBuildCost = 100\nBuildTime = 1\nBody = ActiveBody Tag\nMaxHealth = 100\nEnd\nLocomotor = SET_NORMAL Walk\n";
    const auto decode=[&](const std::string &fields) {
        return DecodeUnit(prefix+fields+"End\n","","Locomotor Walk\nSpeed = 20\nEnd\n","Healer");
    };
    const std::string start="Behavior = AutoHealBehavior Heal\nHealingAmount = 4\nHealingDelay = 1000\nStartsActive = Yes\n";
    const auto supported=decode(start+"Radius = 0.0f\nStartHealingDelay = 2000\nEnd\n");
    BOOST_REQUIRE(supported.regeneration); BOOST_TEST(supported.regeneration->startsActive);
    BOOST_TEST(supported.regeneration->definition.quantity==4000u);
    BOOST_TEST(supported.regeneration->definition.interval.count()==1000000000ll);
    BOOST_TEST(supported.regeneration->definition.damageDelay.count()==2000000000ll);
    BOOST_REQUIRE_EQUAL(supported.omittedBehaviors.size(),1u);
    BOOST_TEST(supported.omittedBehaviors[0].find("No ArmorSet")!=std::string::npos);
    for(const auto field:{"Radius = 100.0f","AffectsWholePlayer = Yes","TriggeredBy = Upgrade_Veterancy_HEROIC",
        "ConflictsWith = Upgrade_Disabled","UnknownHealingPolicy = Yes"}) {
        const auto unsupported=decode(start+field+"\nEnd\n");
        BOOST_CHECK(!unsupported.regeneration); BOOST_TEST(unsupported.omittedBehaviors.size()>1u);
    }
    const auto presentation=decode(start+"UnitHealPulseParticleSystemName = HealFX\nEnd\n");
    BOOST_REQUIRE(presentation.regeneration); BOOST_TEST(presentation.omittedBehaviors.size()>1u);
    BOOST_CHECK_THROW(decode(start+"End\n"+start+"End\n"),std::invalid_argument);
    BOOST_CHECK_THROW(decode(start+"AffectsWholePlayer = Maybe\nEnd\n"),std::invalid_argument);
    BOOST_CHECK_THROW(decode("ExperienceRequired = 0 40 20 120\n"),std::invalid_argument);
}

BOOST_AUTO_TEST_CASE(decode_unit_preserves_unresolved_initial_payload_until_catalog_binding)
{
    const auto decoded=DecodeUnit(R"(Object Carrier
 KindOf = VEHICLE TRANSPORT
 BuildCost = 1
 BuildTime = 1
 Body = ActiveBody Body
  MaxHealth = 100
 End
 Behavior = TransportContain Tag
  Slots = 5
  InitialPayload = Passenger 0
 End
 Locomotor = SET_NORMAL Walk
End
)","","Locomotor Walk\nSpeed = 10\nEnd","Carrier");
    BOOST_REQUIRE(decoded.initialPayload);
    BOOST_TEST(decoded.initialPayload->passengerName=="Passenger");
    BOOST_TEST(decoded.initialPayload->count==0u);
    BOOST_CHECK(!decoded.definition.initialPayload);
}

BOOST_AUTO_TEST_CASE(bind_decoded_unit_catalog_resolves_exact_names_and_stable_keys)
{
    DecodedUnit carrier; carrier.name="Carrier"; carrier.definition.key=DefinitionKey(carrier.name);
    carrier.transport=engine::gameplay::containment::TransportDefinition{5};
    carrier.initialPayload=InitialPayloadReference{"Passenger",2};
    DecodedUnit passenger; passenger.name="Passenger"; passenger.definition.key=DefinitionKey(passenger.name);
    passenger.definition.passenger=engine::gameplay::containment::PassengerSlots{2};
    std::array units{carrier,passenger};
    BindDecodedUnitCatalog(units);
    BOOST_REQUIRE(units[0].definition.initialPayload);
    BOOST_TEST(units[0].definition.initialPayload->passengerDefinition==passenger.definition.key);
    BOOST_TEST(units[0].definition.initialPayload->count==2u);

    auto missing=units; missing[0].definition.initialPayload.reset();
    missing[0].initialPayload->passengerName="passenger";
    BOOST_CHECK_THROW(BindDecodedUnitCatalog(missing),std::invalid_argument);
    auto overCapacity=units; overCapacity[0].definition.initialPayload.reset();
    overCapacity[0].initialPayload->count=3;
    BOOST_CHECK_THROW(BindDecodedUnitCatalog(overCapacity),std::invalid_argument);
}
BOOST_AUTO_TEST_CASE(capture_binding_requires_explicit_special_power_resolution_and_does_not_grant_upgrade)
{
    const std::string object=R"(Object CaptureInfantry
KindOf = INFANTRY
BuildCost = 100
BuildTime = 1
Body = ActiveBody Body
MaxHealth = 100
End
Behavior = SpecialAbility Ability
SpecialPowerTemplate = CapturePower
UpdateModuleStartsAttack = Yes
StartsPaused = Yes
End
Behavior = SpecialAbilityUpdate Update
SpecialPowerTemplate = CapturePower
UnpackTime = 3000
PreparationTime = 20000
PackTime = 2000
End
Behavior = UnpauseSpecialPowerUpgrade Upgrade
SpecialPowerTemplate = CapturePower
TriggeredBy = CaptureUpgrade
End
Locomotor = SET_NORMAL Walk
End
)";
    const std::string powers="SpecialPower CapturePower\nEnum = SPECIAL_INFANTRY_CAPTURE_BUILDING\nReloadTime = 15000\nEnd\n";
    const std::string locomotor="Locomotor Walk\nSpeed = 20\nEnd\n";
    BOOST_CHECK(!DecodeUnit(object,"",locomotor,"CaptureInfantry").capture);
    BOOST_CHECK(!DecodeUnit(object,"",locomotor,"CaptureInfantry",{},powers).capture);
    const auto decoded=DecodeUnit(object,"",locomotor,"CaptureInfantry",{},powers,CapturePermission::Allowed);
    BOOST_REQUIRE(decoded.capture);BOOST_TEST(!decoded.captureEnabled);BOOST_CHECK(!decoded.definition.capture);
    BOOST_TEST(decoded.capture->unpack.count()==3000000000ll);
    BOOST_TEST(decoded.capture->preparation.count()==20000000000ll);
    BOOST_TEST(decoded.capture->recovery.count()==2000000000ll);
    BOOST_TEST(!decoded.omittedBehaviors.empty());
}

BOOST_AUTO_TEST_CASE(typed_weapon_and_default_armor_resolve_through_explicit_zero_hour_mapping)
{
    const std::string base="Object Armored\nBuildCost = 10\nBuildTime = 1\nBody = ActiveBody B\nMaxHealth = 100\nEnd\nWeaponSet\nWeapon = PRIMARY Rifle\nEnd\nLocomotor = SET_NORMAL Walk\n";
    const std::string armor="Armor HumanArmor\nArmor = ARMOR_PIERCING 10%\nArmor = FLAME 150%\nEnd\nArmor NoArmor\nArmor = DEFAULT 100%\nEnd\n";
    const auto decode=[&](const std::string &sets,const std::string &type,std::string_view armorText) {
        return DecodeUnit(base+sets+"End\n","Weapon Rifle\nPrimaryDamage = 10\nAttackRange = 100\n"+type+"End\n",
            "Locomotor Walk\nSpeed = 20\nEnd","Armored",{},"",CapturePermission::Unresolved,armorText);
    };
    const std::string normal="ArmorSet\nConditions = None\nArmor = HumanArmor\nEnd\n";
    const auto unit=decode(normal,"DamageType = SMALL_ARMS\n",armor);
    BOOST_TEST(unit.definition.weapon.damageType.value==3u);BOOST_REQUIRE(unit.armor);
    BOOST_TEST(unit.armorName=="HumanArmor");BOOST_TEST(unit.damagePolicies.size()==38u);
    BOOST_TEST(unit.armor->coefficients[2].millionths==100000u);
    BOOST_TEST(unit.armor->coefficients[6].millionths==1500000u);
    BOOST_CHECK(!unit.definition.armor); // Host owns dense armor catalog binding.
    BOOST_TEST(decode("","","").definition.weapon.damageType.value==0u);
    const auto noArmor=decode("ArmorSet\nArmor = NoArmor\nEnd\n","",armor);
    BOOST_REQUIRE(noArmor.armor);BOOST_TEST(noArmor.armor->coefficients[3].millionths==1000000u);
    BOOST_CHECK_THROW(decode(normal,"",""),std::invalid_argument);
    BOOST_CHECK_THROW(decode(normal,"","Armor Other\nEnd"),std::invalid_argument);
    BOOST_CHECK_THROW(decode(normal+normal,"",armor),std::invalid_argument);
    BOOST_CHECK_THROW(decode("ArmorSet\nConditions = None\nEnd\n","",armor),std::invalid_argument);
    const std::string conditional="ArmorSet\nConditions = PLAYER_UPGRADE\nArmor = MissingUpgradeArmor\nEnd\n";
    BOOST_CHECK_THROW(decode(conditional,"",armor),std::invalid_argument);
    const auto conditionalUnit=decode(normal+conditional,"",armor);
    BOOST_TEST(conditionalUnit.armorName=="HumanArmor");BOOST_REQUIRE_EQUAL(conditionalUnit.omittedBehaviors.size(),1u);
    for(const auto type:{"HEALING","SUBDUAL_VEHICLE","STATUS","MADE_UP"})
        BOOST_CHECK_THROW(decode(normal,std::string{"DamageType = "}+type+"\n",armor),std::invalid_argument);
}
BOOST_AUTO_TEST_CASE(garrison_enrollment_is_explicit_and_reports_excluded_authored_kinds)
{
    const std::string base=R"(Object Infantry
KindOf = INFANTRY
BuildCost = 1
BuildTime = 1
TransportSlotCount = 1
Body = ActiveBody Body
MaxHealth = 100
End
Locomotor = SET_NORMAL Walk
End
)";
    const auto regular=DecodeUnit(base,"","Locomotor Walk\nSpeed = 20\nEnd\n","Infantry");
    BOOST_CHECK(regular.definition.garrisonable);
    const auto noGarrison=DecodeUnit(std::string{base}.replace(std::string{base}.find("KindOf = INFANTRY"),
        std::string{"KindOf = INFANTRY"}.size(),"KindOf = INFANTRY NO_GARRISON"),"",
        "Locomotor Walk\nSpeed = 20\nEnd\n","Infantry");
    BOOST_CHECK(!noGarrison.definition.garrisonable);
    BOOST_CHECK(std::any_of(noGarrison.omittedBehaviors.begin(),noGarrison.omittedBehaviors.end(),
        [](const auto &value){return value.find("NO_GARRISON")!=std::string::npos;}));
    const std::string carrier=R"(Object InfantryCarrier
KindOf = INFANTRY VEHICLE
BuildCost = 1
BuildTime = 1
Body = ActiveBody Body
MaxHealth = 100
End
Behavior = TransportContain Contain
Slots = 1
AllowInsideKindOf = INFANTRY
End
Locomotor = SET_NORMAL Walk
End
)";
    const auto transport=DecodeUnit(carrier,"","Locomotor Walk\nSpeed = 20\nEnd\n","InfantryCarrier");
    BOOST_CHECK(!transport.definition.garrisonable);
    BOOST_CHECK(std::any_of(transport.omittedBehaviors.begin(),transport.omittedBehaviors.end(),
        [](const auto &value){return value.find("garrison carrier")!=std::string::npos;}));
}
