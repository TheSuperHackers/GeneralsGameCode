import games.generalszh.adapters.content.units.unit_definition;
using namespace generalszh::content;
BOOST_AUTO_TEST_CASE(fixed_lifetime_preserves_reference_minimum_and_reports_unbound_random_ranges)
{
    const auto decode=[](std::string fields) { return DecodeUnit(
        "Object Timed\nBuildCost = 1\nBuildTime = 1\nBody = ActiveBody Tag\nMaxHealth = 10\nEnd\nBehavior = LifetimeUpdate Life\n"+fields+
        "End\nLocomotor = SET_NORMAL Walk\nEnd","","Locomotor Walk\nSpeed = 10\nEnd","Timed"); };
    const auto fixed=decode("MinLifetime = 1000\nMaxLifetime = 1000\n");
    BOOST_REQUIRE(fixed.definition.lifetime); BOOST_TEST(fixed.definition.lifetime->count()==1000000000ll);
    const auto minimum=decode(""); BOOST_REQUIRE(minimum.definition.lifetime); BOOST_TEST(minimum.definition.lifetime->count()==33333333ll);
    const auto random=decode("MinLifetime = 1000\nMaxLifetime = 2000\n");
    BOOST_CHECK(!random.definition.lifetime); BOOST_REQUIRE_EQUAL(random.omittedBehaviors.size(),2u);
    BOOST_CHECK_THROW(decode("MinLifetime = 2000\nMaxLifetime = 1000\n"),std::invalid_argument);
}

BOOST_AUTO_TEST_CASE(stealth_and_detector_bindings_decode_only_configured_behaviors)
{
    const std::string prefix=R"(Object Concealed
 BuildCost = 1
 BuildTime = 1
 VisionRange = 200
 Body = ActiveBody Body
 MaxHealth = 100
 End
 Locomotor = SET_NORMAL Walk
 )";
    const std::string locomotor="Locomotor Walk\nSpeed = 20\nEnd\n";
    const auto decodeStealth=[&](std::string_view innateStealthField) {
        return DecodeUnit(prefix+
            "Behavior = StealthUpdate Cloak\nStealthDelay = 250\n"+std::string{innateStealthField}+
            "StealthForbiddenConditions = MOVING FIRING_PRIMARY\nEnd\nEnd\n",
            "",locomotor,"Concealed");
    };
    const auto stealth=decodeStealth("");
    BOOST_REQUIRE(stealth.definition.concealment); BOOST_REQUIRE(stealth.definition.stealthPolicy);
    BOOST_TEST(stealth.definition.concealment->stealthDelay==std::chrono::milliseconds{250});
    BOOST_TEST(stealth.definition.stealthPolicy->innateStealth);
    BOOST_CHECK((stealth.definition.stealthPolicy->forbiddenConditions &
        static_cast<std::uint8_t>(generalszh::concealment::StealthForbiddenCondition::Moving)) != 0);
    BOOST_CHECK((stealth.definition.stealthPolicy->forbiddenConditions &
        static_cast<std::uint8_t>(generalszh::concealment::StealthForbiddenCondition::Firing)) != 0);
    const auto explicitYes=decodeStealth("InnateStealth = Yes\n");
    const auto explicitNo=decodeStealth("InnateStealth = No\n");
    BOOST_REQUIRE(explicitYes.definition.stealthPolicy); BOOST_REQUIRE(explicitNo.definition.stealthPolicy);
    BOOST_TEST(explicitYes.definition.stealthPolicy->innateStealth);
    BOOST_TEST(!explicitNo.definition.stealthPolicy->innateStealth);

    for (const auto rangeField : {std::string{}, std::string{"DetectionRange = 0\n"},
        std::string{"DetectionRange = 200\n"}})
    {
        const auto detector=DecodeUnit(prefix+"Behavior = StealthDetectorUpdate Detector\nDetectionRate = 100\n"+
            rangeField+"CanDetectWhileContained = Yes\nInitiallyDisabled = Yes\nEnd\nEnd\n",
            "",locomotor,"Concealed");
        BOOST_REQUIRE(detector.definition.detection);
        BOOST_TEST(detector.definition.detection->detectionRangeCells==20u);
        BOOST_TEST(detector.definition.detection->canDetectWhileContained);
        BOOST_TEST(detector.definition.detection->initiallyDisabled);
    }
    BOOST_CHECK_THROW(DecodeUnit(prefix+
        "Behavior = StealthUpdate Cloak\nStealthDelay = 250\nMoveThresholdSpeed = 1\nEnd\nEnd\n",
        "",locomotor,"Concealed"),std::invalid_argument);
    BOOST_CHECK_THROW(DecodeUnit(prefix+
        "Behavior = StealthDetectorUpdate Detector\nDetectionRate = 100\nCanDetectWhileGarrisoned = Yes\nEnd\nEnd\n",
        "",locomotor,"Concealed"),std::invalid_argument);
}

BOOST_AUTO_TEST_CASE(weapon_splash_fields_preserve_friendly_default_and_reject_unrepresentable_legacy_flags)
{
    const std::string object="Object SplashUnit\nBuildCost = 1\nBuildTime = 1\nBody = ActiveBody Body\nMaxHealth = 100\nEnd\nWeaponSet\nWeapon = PRIMARY Cannon\nEnd\nLocomotor = SET_NORMAL Walk\nEnd\n";
    const auto decode=[&](const std::string &fields) {
        return DecodeUnit(object,"Weapon Cannon\nPrimaryDamage = 10\nAttackRange = 100\n"+fields+"End\n",
            "Locomotor Walk\nSpeed = 20\nEnd\n","SplashUnit");
    };
    using Affect=engine::gameplay::combat::RadiusDamageAffect;
    const auto defaults=decode("");
    BOOST_CHECK(defaults.definition.weapon.radiusDamageAffects.Contains(Affect::Allies));
    BOOST_CHECK(defaults.definition.weapon.radiusDamageAffects.Contains(Affect::Enemies));
    BOOST_CHECK(defaults.definition.weapon.radiusDamageAffects.Contains(Affect::Neutrals));
    BOOST_CHECK(!defaults.definition.weapon.radiusDamageAffects.Contains(Affect::Self));

    const auto splash=decode("SecondaryDamage = 8.5\nPrimaryDamageRadius = 25.01\nSecondaryDamageRadius = 15\n"
        "RadiusDamageAffects = ALLIES|ENEMIES|NEUTRALS\nDamageDealtAtSelfPosition = No\n");
    BOOST_TEST(splash.definition.weapon.secondaryDamage==8500u);
    BOOST_TEST(splash.definition.weapon.primaryRadiusCells==3u);
    BOOST_TEST(splash.definition.weapon.secondaryRadiusCells==2u); // Primary may be larger than secondary.
    BOOST_CHECK(splash.definition.weapon.radiusDamageAffects.Contains(Affect::Allies));
    BOOST_CHECK(!splash.definition.weapon.radiusDamageAffects.Contains(Affect::Self));
    const auto selfOnly=decode("RadiusDamageAffects = SELF ENEMIES\n");
    BOOST_CHECK(selfOnly.definition.weapon.radiusDamageAffects.Contains(Affect::Self));
    BOOST_CHECK(!selfOnly.definition.weapon.radiusDamageAffects.Contains(Affect::Allies));
    BOOST_TEST(RadiusCells("0.01",ContentScale{})==1u);
    BOOST_TEST(RadiusCells("10.0",ContentScale{})==1u);
    BOOST_TEST(RadiusCells("10.01",ContentScale{})==2u);
    BOOST_CHECK_THROW(decode("PrimaryDamageRadius = 42949672951\n"),std::out_of_range);
    for(const auto flag:{"SUICIDE","NOT_SIMILAR","NOT_AIRBORNE"})
        BOOST_CHECK_THROW(decode(std::string{"RadiusDamageAffects = "+std::string{flag}+"\n"}),std::invalid_argument);
    BOOST_CHECK_THROW(decode("DamageDealtAtSelfPosition = Yes\n"),std::invalid_argument);
    BOOST_CHECK_THROW(decode("DamageDealtAtSelfPosition = Maybe\n"),std::invalid_argument);
}
BOOST_AUTO_TEST_CASE(zero_or_omitted_reference_clip_becomes_explicit_unlimited_ammunition)
{
    const std::string object="Object Tank\nBuildCost = 800\nBuildTime = 10\nBody = ActiveBody Tag\nMaxHealth = 300\nEnd\nWeaponSet\nWeapon = PRIMARY Cannon\nEnd\nLocomotor = SET_NORMAL Drive\nEnd";
    for(const auto clip:{"","ClipSize = 0\n"}) {
        const auto unit=DecodeUnit(object,std::string{"Weapon Cannon\nPrimaryDamage = 60\nAttackRange = 150\n"}+clip+"End",
            "Locomotor Drive\nSpeed = 30\nEnd","Tank");
        BOOST_CHECK(unit.definition.weapon.ammunition==engine::gameplay::combat::AmmunitionPolicy::Unlimited);
        BOOST_TEST(unit.definition.weapon.clipSize==0u);
        BOOST_TEST(unit.definition.weapon.shotInterval.count()==0); BOOST_TEST(unit.definition.weapon.reloadTime.count()==0);
    }
}
BOOST_AUTO_TEST_CASE(prefire_fields_decode_to_typed_duration_and_policy)
{
    const std::string object="Object PrefireUnit\nBuildCost = 1\nBuildTime = 1\nBody = ActiveBody Tag\nMaxHealth = 10\nEnd\nWeaponSet\nWeapon = PRIMARY Cannon\nEnd\nLocomotor = SET_NORMAL Walk\nEnd";
    const auto decode=[&](const std::string &fields) {
        return DecodeUnit(object,"Weapon Cannon\nPrimaryDamage = 1\nAttackRange = 100\n"+fields+"End\n",
            "Locomotor Walk\nSpeed = 20\nEnd","PrefireUnit");
    };
    using engine::gameplay::combat::PrefirePolicy;
    const std::array policies{
        std::pair{"PER_SHOT",PrefirePolicy::PerShot},
        std::pair{"PER_ATTACK",PrefirePolicy::PerAttack},
        std::pair{"PER_CLIP",PrefirePolicy::PerClip}};
    for(const auto &[name,policy]:policies)
    {
        const auto unit=decode("PreAttackDelay = 101\nPreAttackType = "+std::string{name}+"\n");
        BOOST_TEST(unit.definition.weapon.preAttackDelay.count()==101000000ll);
        BOOST_CHECK(unit.definition.weapon.preAttackType==policy);
    }
    const auto defaulted=decode("PreAttackDelay = 101\n");
    BOOST_CHECK(defaulted.definition.weapon.preAttackType==PrefirePolicy::PerShot);
    BOOST_CHECK_THROW(decode("PreAttackType = PER_TARGET\n"),std::invalid_argument);
}
BOOST_AUTO_TEST_CASE(supply_truck_reference_fields_and_builder_markers_decode)
{
    const std::string prefix="Object ChinaVehicleSupplyTruck\nBuildCost = 600\nBuildTime = 10\nBody = ActiveBody Tag\nMaxHealth = 300\nEnd\nLocomotor = SET_NORMAL SupplyTruckLocomotor\n";
    const std::string behavior="Behavior = SupplyTruckAIUpdate Tag\nMaxBoxes = 4\nSupplyCenterActionDelay = 400\nSupplyWarehouseActionDelay = 1000\nEnd\n";
    const auto decode=[&](const std::string &value){return DecodeUnit(prefix+value+"End","","Locomotor SupplyTruckLocomotor\nSpeed = 40\nEnd","ChinaVehicleSupplyTruck");};
    const auto truck=decode(behavior); BOOST_REQUIRE(truck.definition.harvest);
    BOOST_CHECK(!truck.progression); BOOST_CHECK(!truck.regeneration);
    BOOST_TEST(truck.definition.harvest->capacity==4u); BOOST_TEST(truck.definition.harvest->pickup.count()==1000000000ll);
    BOOST_TEST(truck.definition.harvest->unload.count()==400000000ll); BOOST_TEST(!truck.definition.builder);
    BOOST_CHECK_THROW(decode(behavior+behavior),std::invalid_argument);
    auto invalid=behavior; invalid.replace(invalid.find("MaxBoxes = 4"),12,"MaxBoxes = 0");
    BOOST_CHECK_THROW(decode(invalid),std::invalid_argument);
    for(const auto type:{"DozerAIUpdate","WorkerAIUpdate"}) {
        const auto builder=decode(std::string{"Behavior = "}+type+" Tag\nEnd\n");
        BOOST_TEST(builder.definition.builder); BOOST_CHECK(!builder.definition.harvest); BOOST_CHECK(!builder.definition.manualRepair);
        BOOST_REQUIRE_EQUAL(builder.omittedBehaviors.size(),2u); BOOST_TEST(builder.omittedBehaviors[0]==type);
    }
    const auto repairing=decode("Behavior = DozerAIUpdate Tag\nRepairHealthPercentPerSecond = 2%\nEnd\n");
    BOOST_REQUIRE(repairing.definition.manualRepair);
    BOOST_TEST(repairing.definition.manualRepair->rateNumerator==1u);
    BOOST_TEST(repairing.definition.manualRepair->rateDenominator==50u);
    BOOST_TEST(repairing.definition.manualRepair->interval==std::chrono::seconds{1});
    BOOST_CHECK(repairing.definition.manualRepair->intervalPolicy==engine::gameplay::rts::repair::RepairIntervalPolicy::SimulationStep);
    BOOST_CHECK_THROW(decode("Behavior = DozerAIUpdate Tag\nRepairHealthPercentPerSecond = 0%\nEnd\n"),std::invalid_argument);
    BOOST_CHECK_THROW(decode("Behavior = DozerAIUpdate Tag\nRepairHealthPercentPerSecond = 2\nEnd\n"),std::invalid_argument);
    BOOST_CHECK_THROW(decode("Behavior = DozerAIUpdate Tag\nRepairHealthPercentPerSecond = 101%\nEnd\n"),std::invalid_argument);
}
BOOST_AUTO_TEST_CASE(reference_ranger_fields_translate_without_legacy_objects_or_floating_point)
{
    const auto unit=DecodeUnit(R"(
Object AmericaInfantryRanger
 BuildCost = 225
 BuildTime = 5.0
 ExperienceValue = 20 20 40 60
 ExperienceRequired = 0 40 60 120
 SkillPointValue = 7 8 9 10
 IsTrainable = Yes
 Body = ActiveBody ModuleTag_03
  MaxHealth = 180.0
  InitialHealth = 180.0
 End
 WeaponSet
  Conditions = None
  Weapon = PRIMARY RangerAdvancedCombatRifle
 End
 WeaponSet
  Conditions = PLAYER_UPGRADE
  Weapon = PRIMARY UnsupportedUpgradeRifle
 End
 Behavior = AIUpdateInterface ModuleTag_06
  AutoAcquireEnemiesWhenIdle = Yes
 End
 Behavior = SlowDeathBehavior Tag
  SinkDelay = 3000
 End
 Locomotor = SET_NORMAL BasicHumanLocomotor
End
)",R"(
Weapon RangerAdvancedCombatRifle
 PrimaryDamage = 5.0
 AttackRange = 100.0
 ClipSize = 3
 DelayBetweenShots = 100
 ClipReloadTime = 700
End
)","Locomotor BasicHumanLocomotor\nSpeed = 20\nEnd","AmericaInfantryRanger");
    BOOST_TEST(unit.definition.cost==225u); BOOST_TEST(unit.definition.duration.count()==5000000000ll);
    BOOST_TEST(unit.definition.health==180000u); BOOST_TEST(unit.definition.cellsPerSecond==2u);
    BOOST_TEST(unit.definition.weapon.damage==5000u); BOOST_TEST(unit.definition.weapon.rangeCells==10u);
    BOOST_TEST(unit.definition.weapon.clipSize==3u); BOOST_TEST(unit.definition.weapon.shotInterval.count()==100000000ll);
    BOOST_TEST(unit.definition.weapon.reloadTime.count()==700000000ll); BOOST_TEST(unit.definition.acquisition.enabled);
    BOOST_REQUIRE(unit.omittedBehaviors.size()==2u); BOOST_TEST(unit.omittedBehaviors[0]=="SlowDeathBehavior");
    const std::vector duplicates{unit,unit}; BOOST_CHECK_THROW(ValidateUnitKeys(duplicates),std::invalid_argument);
    BOOST_REQUIRE(unit.progression); BOOST_TEST(unit.progression->required[1]==40u);
    BOOST_TEST(unit.progression->required[3]==120u); BOOST_TEST(unit.progression->trainable);
    BOOST_TEST(unit.progression->skillPointValues[3]==10u);
    BOOST_CHECK(!unit.regeneration); // No inherited heroic healing is fabricated.
}
BOOST_AUTO_TEST_CASE(ignored_in_gui_is_derived_from_kind_of_without_defining_owner_membership)
{
    const auto decode=[](std::string_view kinds) {
        return DecodeUnit("Object Target\nKindOf = "+std::string{kinds}+R"(
BuildCost = 1
BuildTime = 1
ExperienceValue = 25 25 25 25
ExperienceRequired = 0 10 20 30
IsTrainable = No
Body = ActiveBody Body
MaxHealth = 10
End
Locomotor = SET_NORMAL Walk
End
)" ,"","Locomotor Walk\nSpeed = 10\nEnd","Target");
    };
    const auto ordinary=decode("INFANTRY");
    const auto ignored=decode("INFANTRY IGNORED_IN_GUI");
    BOOST_CHECK(!ordinary.ignoredInGui);
    BOOST_CHECK(ignored.ignoredInGui);
    BOOST_REQUIRE(ordinary.progression);
    BOOST_CHECK(!ordinary.progression->trainable);
}
BOOST_AUTO_TEST_CASE(object_prerequisites_are_retained_for_explicit_composition_binding)
{
    const auto unit=DecodeUnit(R"(Object PrereqUnit
BuildCost = 1
BuildTime = 1
Body = ActiveBody Body
MaxHealth = 10
End
Prerequisites
 Object = Barracks AlternateBarracks
 Object = StrategyCenter
End
Locomotor = SET_NORMAL Walk
End
)","",R"(Locomotor Walk
Speed = 20
End
)","PrereqUnit");
