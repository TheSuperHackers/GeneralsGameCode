// ScoreScreen.wnd column headers. Each cell stacks a raw count on top of
// the dollar-value aggregate ($X.XXk with a percent delta from the column
// average), so the headers stay short and the "$" in the value line
// disambiguates which number is which.
GUI:ScoreUnitBuilt
"Units Built"
END

GUI:ScoreUnitLost
"Units Lost"
END

GUI:ScoreUnitKilled
"Units Killed"
END

GUI:ScoreBldgBuilt
"Buildings Built"
END

GUI:ScoreBldgLost
"Buildings Lost"
END

GUI:ScoreBldgKilled
"Buildings Killed"
END

// Repurposes the retail-vestigial Score column to show
// (value killed) / (income) * 100, or "-" when no income was earned.
GUI:ScoreEfficiency
"Efficiency"
END
