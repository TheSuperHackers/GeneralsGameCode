#define BOOST_TEST_MODULE EngineEvents
#include <boost/test/included/unit_test.hpp>
#include <array>
#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <limits>
import engine.events.ordering.batch_order;
using namespace engine::events;

BOOST_AUTO_TEST_CASE(batch_order_is_tick_phase_system_job_chunk_lexicographic)
{
	const auto max = (std::numeric_limits<std::uint32_t>::max)();
	std::array<BatchOrder, 6> ordered{{
		{{7, 1}, 2, 3, 4}, {{7, 1}, 2, 3, 5}, {{7, 1}, 2, 4, 0},
		{{7, 1}, 3, 0, 0}, {{7, 2}, 0, 0, 0}, {{8, 0}, 0, 0, 0}}};
	BOOST_CHECK(std::is_sorted(ordered.begin(), ordered.end()));
	for (std::size_t i = 1; i < ordered.size(); ++i) BOOST_CHECK(ordered[i - 1] < ordered[i]);
	BOOST_CHECK((BatchOrder{{7, max}, max, max, max} < BatchOrder{{8, 0}, 0, 0, 0}));
	BOOST_CHECK((BatchOrder{{7, 1}, 2, 3, 4} == ordered[0]));
}

BOOST_AUTO_TEST_CASE(batch_order_does_not_depend_on_input_permutation)
{
	std::array<BatchOrder, 4> a{{{{42, 2}, 8, 1, 0}, {{42, 2}, 1, 7, 0},
		{{42, 2}, 1, 6, 0}, {{42, 2}, 1, 6, 1}}};
	auto b = a;
	std::reverse(b.begin(), b.end());
	std::sort(a.begin(), a.end());
	std::sort(b.begin(), b.end());
	BOOST_CHECK(a == b);
}
