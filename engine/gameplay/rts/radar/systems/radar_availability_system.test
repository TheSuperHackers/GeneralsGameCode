namespace radar_test
{
struct ProviderBinding final
{
	ecs::Entity account{};
	bool resistant{};
};

struct ProviderGrant final
{
	bool granted{};
};

struct ProviderTarget final
{
	std::uint32_t wordCount{1};
	std::uint64_t schemaHash{1};
};

struct WordMarker final
{
};
}

