#include <boost/test/unit_test.hpp>
#include <cstdint>

import engine.gameplay.rts.rank.components.rank_state;

using namespace engine::gameplay::rts::rank;

BOOST_AUTO_TEST_CASE(rank_state_is_serializable_authoritative_account_progression)
{
	RankState state{123, 4};
	BOOST_TEST(state.skillPoints == 123u);
	BOOST_TEST(state.level == 4u);
	BOOST_CHECK(ecs::ComponentTraits<RankState>::Persistence == ecs::PersistencePolicy::Serializable);
	BOOST_TEST(ecs::ComponentTraits<RankState>::Version == 1u);
}
