#include <boost/test/unit_test.hpp>
#include <cstdint>
#include <stdexcept>

import engine.gameplay.rts.rank.components.rank_skill_award_modifier;

using namespace engine::gameplay::rts::rank;

BOOST_AUTO_TEST_CASE(rank_skill_award_modifier_defaults_to_one_to_one)
{
	const RankSkillAwardModifier modifier;
	BOOST_TEST(modifier.numerator == 1u);
	BOOST_TEST(modifier.denominator == 1u);
	BOOST_CHECK(IsValidRankSkillAwardModifier(modifier));
	BOOST_CHECK(ecs::ComponentTraits<RankSkillAwardModifier>::Persistence ==
		ecs::PersistencePolicy::Serializable);
}

BOOST_AUTO_TEST_CASE(rank_skill_award_modifier_rejects_zero_denominator)
{
	BOOST_CHECK_THROW(ValidateRankSkillAwardModifier({3, 0}), std::invalid_argument);
}
