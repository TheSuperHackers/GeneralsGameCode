#define BOOST_TEST_MODULE EngineGameplayPickups
#include <boost/test/included/unit_test.hpp>
#include <array>
#include <cstddef>
#include <span>

import engine.gameplay.pickups.algorithms.pickup_arbitration;

using engine::gameplay::pickups::PickupCandidate;
using engine::gameplay::pickups::PickupClaim;
using engine::gameplay::pickups::SelectSuccessAware;

BOOST_AUTO_TEST_CASE(empty_candidate_validation_is_a_noop)
{
	const std::span<const PickupCandidate> empty{};
	BOOST_CHECK_NO_THROW(engine::gameplay::pickups::ValidateCanonicalCandidates(empty));
}

BOOST_AUTO_TEST_CASE(success_aware_arbitration_skips_a_failed_collector)
{
	const std::array candidates{
		PickupCandidate{{7, 1}, {1, 1}, 0, 0, false, true},
		PickupCandidate{{7, 1}, {2, 1}, 1, 1, false, true}};
	std::array<PickupClaim, 2> selected{};
	const auto count = SelectSuccessAware(candidates, selected,
		[](const PickupCandidate &candidate) { return candidate.collector.index == 2; });
	BOOST_REQUIRE_EQUAL(count, 1u);
	BOOST_TEST(selected[0].collector.index == 2u);
}

BOOST_AUTO_TEST_CASE(non_multi_claim_is_deterministic_and_multi_claims_remain_explicit)
{
	const std::array candidates{
		PickupCandidate{{8, 1}, {4, 1}, 0, 0, false, true},
		PickupCandidate{{8, 1}, {5, 1}, 1, 1, false, true},
		PickupCandidate{{9, 1}, {6, 1}, 0, 2, true, true},
		PickupCandidate{{9, 1}, {7, 1}, 1, 3, true, true}};
	std::array<PickupClaim, 4> selected{};
	const auto count = SelectSuccessAware(candidates, selected,
		[](const PickupCandidate &) { return true; });
	BOOST_REQUIRE_EQUAL(count, 3u);
	BOOST_TEST(selected[0].collector.index == 4u);
	BOOST_TEST(selected[1].crate.index == 9u);
	BOOST_TEST(selected[2].collector.index == 7u);
}

BOOST_AUTO_TEST_CASE(allow_multi_deduplicates_repeated_contacts_for_one_collector)
{
	const std::array candidates{
		PickupCandidate{{10, 1}, {4, 1}, 0, 0, true, true},
		PickupCandidate{{10, 1}, {4, 1}, 1, 1, true, true},
		PickupCandidate{{10, 1}, {5, 1}, 2, 2, true, true}};
	std::array<PickupClaim, 3> selected{};
	std::size_t policyCalls = 0;
	const auto count = SelectSuccessAware(candidates, selected,
		[&](const PickupCandidate &) { ++policyCalls; return true; });
	BOOST_REQUIRE_EQUAL(count, 2u);
	BOOST_TEST(policyCalls == 2u);
	BOOST_TEST(selected[0].collector.index == 4u);
	BOOST_TEST(selected[1].collector.index == 5u);
}

BOOST_AUTO_TEST_CASE(arbitration_checks_capacity_before_success_policy)
{
	const std::array candidates{PickupCandidate{{11, 1}, {4, 1}, 0, 0, false, true}};
	std::array<PickupClaim, 0> selected{};
	bool called = false;
	BOOST_CHECK_THROW(SelectSuccessAware(candidates, selected,
		[&](const PickupCandidate &) { called = true; return true; }), std::length_error);
	BOOST_CHECK(!called);
}
