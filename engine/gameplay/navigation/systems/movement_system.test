#include <boost/test/unit_test.hpp>
#include <array>
import engine.gameplay.navigation.systems.movement_system;
import engine.ecs.scheduler.scheduler;
using namespace engine::gameplay::navigation;
BOOST_AUTO_TEST_CASE(movement_keeps_fractional_step_credit_and_stops_at_destination)
{
    const std::array<std::uint8_t, 3> terrain{1,1,1}; NavigationGrid grid(3,1,terrain);
    engine::jobs::JobSystem workers({2}); FlowFields fields(grid, {1,3}); const std::array goals{Cell{2}}; fields.Prepare(goals, workers);
    ecs::World world; RegisterMovementComponents(world); world.FinalizeComponents();
    const auto actor = world.Create<GridPosition, MoveGoal, MoveSpeed, MoveCredit, MoveField, MoveEnabled, MoveResult, MovementActivity>();
    world.Get<MoveGoal>(actor)->cell = 2; world.Get<MoveSpeed>(actor)->cellsPerSecond = 10; world.Get<MoveField>(actor)->index = fields.Find(2);
    MovementSystem system(world, workers, grid, fields); ecs::SystemRegistry registry; registry.Register(system); registry.Finalize(world.Components());
    ecs::Scheduler scheduler(world, registry, workers); const engine::time::FixedStep step{30}; scheduler.Finalize(step);
    BOOST_TEST(registry.Count() == 1u);
    scheduler.Execute({0,step}); scheduler.Execute({1,step}); BOOST_TEST(world.Get<GridPosition>(actor)->cell == 0u);
    scheduler.Execute({2,step}); BOOST_TEST(world.Get<GridPosition>(actor)->cell == 1u);
    for (std::uint64_t tick = 3; tick != 9; ++tick) scheduler.Execute({tick,step});
    BOOST_TEST(world.Get<GridPosition>(actor)->cell == 2u); BOOST_CHECK(world.Get<MoveResult>(actor)->status == MoveStatus::Arrived);
}

#include <boost/test/unit_test.hpp>
#include <array>
#include <span>
#include <vector>
import engine.gameplay.navigation.systems.movement_system;
import engine.ecs.scheduler.scheduler;
using namespace engine::gameplay::navigation;
BOOST_AUTO_TEST_CASE(movement_routes_and_actual_positions_match_at_one_two_four_workers)
{
    auto run = [](std::size_t workerCount) {
        std::array<std::uint8_t, 64> terrain; terrain.fill(1); for (int i = 1; i != 7; ++i) terrain[i * 8 + 4] = 0;
        NavigationGrid grid(8,8,terrain); engine::jobs::JobSystem jobs({workerCount});
        ecs::World world; RegisterMovementComponents(world); world.FinalizeComponents();
        FlowFields fields(grid, {2,64}); MovementSystem movement(world,jobs,grid,fields,2048);
        const engine::time::FixedStep step{20};
        ecs::SystemRegistry registry; registry.Register(movement); registry.Finalize(world.Components());
        ecs::Scheduler scheduler(world,registry,jobs); scheduler.Finalize(step);
    BOOST_TEST(registry.Count() == 1u);
        std::vector<ecs::Entity> actors; std::vector<MoveInput> commands;
        for (int i = 0; i != 2048; ++i) {
            const auto actor = world.Create<GridPosition, MoveGoal, MoveSpeed, MoveCredit, MoveField, MoveEnabled, MoveResult>();
            actors.push_back(actor); world.Get<MoveSpeed>(actor)->cellsPerSecond = 20;
            commands.push_back({actor, i % 2 ? Cell{63} : Cell{7}}); }
        std::vector<std::uint64_t> result;
        for (std::uint64_t tick = 0; tick != 16; ++tick) {
            movement.SetInputs(tick == 0 ? std::span<const MoveInput>(commands) : std::span<const MoveInput>{});
            scheduler.Execute({tick,step});
            for (const auto actor : actors) {
                BOOST_TEST(grid.Walkable(world.Get<GridPosition>(actor)->cell));
                result.insert(result.end(), {actor.index, actor.generation, world.Get<GridPosition>(actor)->cell,
                    static_cast<std::uint64_t>(world.Get<MoveResult>(actor)->status)}); } }
        for (const auto actor : actors) BOOST_CHECK(world.Get<MoveResult>(actor)->status == MoveStatus::Arrived);
        return result;
    };
    const auto expected = run(1); BOOST_CHECK(run(2) == expected); BOOST_CHECK(run(4) == expected);
}
BOOST_AUTO_TEST_CASE(disconnected_destination_is_explicitly_unreachable)
{
    const std::array<std::uint8_t,3> terrain{1,0,1}; NavigationGrid grid(3,1,terrain); engine::jobs::JobSystem jobs({1});
    ecs::World world; RegisterMovementComponents(world); world.FinalizeComponents();
    FlowFields fields(grid); MovementSystem movement(world,jobs,grid,fields);
    const engine::time::FixedStep step{20};
    ecs::SystemRegistry registry; registry.Register(movement); registry.Finalize(world.Components());
    ecs::Scheduler scheduler(world,registry,jobs); scheduler.Finalize(step);
    BOOST_TEST(registry.Count() == 1u);
    const auto actor = world.Create<GridPosition, MoveGoal, MoveSpeed, MoveCredit, MoveField, MoveEnabled, MoveResult>();
    const std::array commands{MoveInput{actor,2}}; movement.SetInputs(commands);
    BOOST_TEST(world.Get<MoveGoal>(actor)->cell==InvalidCell);
    scheduler.Execute({0,step});
    BOOST_TEST(world.Get<GridPosition>(actor)->cell == 0u); BOOST_CHECK(world.Get<MoveResult>(actor)->status == MoveStatus::Unreachable);
}

BOOST_AUTO_TEST_CASE(range_goal_routes_to_reachable_firing_cell_without_rewriting_authored_aim)
{
    const std::array<std::uint8_t,15> terrain{1,1,1,1,1,1,1,0,1,1,1,1,1,1,1};
    NavigationGrid grid(5,3,terrain); engine::jobs::JobSystem jobs({2});
    ecs::World world; RegisterMovementComponents(world); world.FinalizeComponents();
    FlowFields fields(grid,{2,15}); MovementSystem movement(world,jobs,grid,fields);
    const auto actor=world.Create<GridPosition,MoveGoal,MoveRangeGoal,MoveSpeed,MoveCredit,MoveField,MoveEnabled,MoveResult,MovementActivity>();
    world.Get<GridPosition>(actor)->cell=0; world.Get<MoveSpeed>(actor)->cellsPerSecond=20;
    SetMoveRangeGoal(*world.Get<MoveRangeGoal>(actor),*world.Get<MoveCredit>(actor),7,1);
    ecs::SystemRegistry registry; registry.Register(movement); registry.Finalize(world.Components());
    ecs::Scheduler scheduler(world,registry,jobs); const engine::time::FixedStep step{20}; scheduler.Finalize(step);
    scheduler.Execute({0,step}); BOOST_TEST(world.Get<GridPosition>(actor)->cell==1u);
    BOOST_TEST(world.Get<MovementActivity>(actor)->cellsMovedThisTick==1u);
    BOOST_CHECK(world.Get<MoveResult>(actor)->status==MoveStatus::Moving);
    scheduler.Execute({1,step}); BOOST_TEST(world.Get<GridPosition>(actor)->cell==2u);
    BOOST_TEST(world.Get<MovementActivity>(actor)->cellsMovedThisTick==1u);
    BOOST_CHECK(world.Get<MoveResult>(actor)->status==MoveStatus::Arrived);
    BOOST_TEST(world.Get<MoveRangeGoal>(actor)->center==7u);
    BOOST_TEST(world.Get<MoveGoal>(actor)->cell==InvalidCell);

    SetMoveRangeGoal(*world.Get<MoveRangeGoal>(actor),*world.Get<MoveCredit>(actor),7,0);
    scheduler.Execute({2,step});
    BOOST_TEST(world.Get<GridPosition>(actor)->cell==2u);
    BOOST_TEST(world.Get<MovementActivity>(actor)->cellsMovedThisTick==0u);
    BOOST_CHECK(world.Get<MoveResult>(actor)->status==MoveStatus::Unreachable);
}

BOOST_AUTO_TEST_CASE(range_goal_routes_to_later_reachable_seed_after_disconnected_earlier_seed)
{
    // Cell 6 is the first sorted walkable seed around blocked aim 7, but is isolated.
    // Cell 8 is the later seed and is reachable from actor cell 4 through 3.
    const std::array<std::uint8_t,15> terrain{
        0,0,0,1,1,
        0,1,0,1,0,
        0,0,0,0,0};
    NavigationGrid grid(5,3,terrain); engine::jobs::JobSystem jobs({2});
    ecs::World world; RegisterMovementComponents(world); world.FinalizeComponents();
    FlowFields fields(grid,{1,15}); MovementSystem movement(world,jobs,grid,fields);
    const auto actor=world.Create<GridPosition,MoveGoal,MoveRangeGoal,MoveSpeed,MoveCredit,MoveField,MoveEnabled,MoveResult>();
    world.Get<GridPosition>(actor)->cell=4; world.Get<MoveSpeed>(actor)->cellsPerSecond=20;
    SetMoveRangeGoal(*world.Get<MoveRangeGoal>(actor),*world.Get<MoveCredit>(actor),7,1);
    ecs::SystemRegistry registry; registry.Register(movement); registry.Finalize(world.Components());
    ecs::Scheduler scheduler(world,registry,jobs); const engine::time::FixedStep step{20}; scheduler.Finalize(step);
    scheduler.Execute({0,step}); BOOST_TEST(world.Get<GridPosition>(actor)->cell==3u);
    BOOST_CHECK(world.Get<MoveResult>(actor)->status==MoveStatus::Moving);
    scheduler.Execute({1,step}); BOOST_TEST(world.Get<GridPosition>(actor)->cell==8u);
    BOOST_CHECK(world.Get<MoveResult>(actor)->status==MoveStatus::Arrived);
}
