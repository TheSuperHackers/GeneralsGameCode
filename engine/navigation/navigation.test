#define BOOST_TEST_MODULE EngineNavigationTests
#include <boost/test/included/unit_test.hpp>

import engine.navigation;

BOOST_AUTO_TEST_SUITE(navigation_module)

BOOST_AUTO_TEST_CASE(umbrella_exports_existing_cost_policy)
{
    BOOST_TEST(navigation::estimateGoalCost(1, 1) == 15);
    BOOST_TEST(navigation::stepCost(0, 1, 1, false) == 14);
    BOOST_TEST(navigation::turnCost(1, 0, 0, 1) == 8);
}

BOOST_AUTO_TEST_SUITE_END()
