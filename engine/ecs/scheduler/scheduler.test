constexpr engine::time::SimulationTime TestTime(std::uint64_t tick)
{
	return {tick, engine::time::FixedStep{60}};
}
}

namespace ecs_scheduler_test
{

struct Position
{
	int value{0};
};

struct Velocity
{
	int value{0};
};

struct Marker
{
	int value{0};
};

struct PreSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::vector<int> *log{nullptr};

	void Execute(Query::Chunk chunk, ecs::SystemContext &context)
	{
		if (log != nullptr)
			log->push_back(static_cast<int>(context.Tick()));
		visited += chunk.Count();
	}

	std::size_t visited{0};
};

struct SimulationSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::vector<int> *log{nullptr};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		if (log != nullptr)
			log->push_back(1);
		visited += chunk.Count();
	}

	std::size_t visited{0};
};

struct PostSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::vector<int> *log{nullptr};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		if (log != nullptr)
			log->push_back(2);
		visited += chunk.Count();
	}

	std::size_t visited{0};
};

