{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::vector<int> *log{nullptr};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		if (log != nullptr)
			log->push_back(2);
		visited += chunk.Count();
	}

	std::size_t visited{0};
};

struct UnrelatedSystem
{
	using Query = ecs::Query<ecs::Read<Velocity>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct AmbiguousWriteA
{
	using Query = ecs::Query<ecs::Write<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct AmbiguousWriteB
{
	using Query = ecs::Query<ecs::Write<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct CycleA
{
	using Query = ecs::Query<ecs::Read<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct CycleB
{
	using Query = ecs::Query<ecs::Read<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct BarrierAddSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	ecs::Entity target{};

	void Execute(Query::Chunk chunk, ecs::SystemContext &context)
	{
		for (const ecs::Entity entity : chunk.Entities())
		{
			if (entity == target)
				context.Commands().Add<Marker>(entity, Marker{7});
		}
	}
};

struct BarrierObserveSystem
{
	using Query = ecs::Query<ecs::Read<Marker>>;
	std::size_t observed{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		observed += chunk.Count();
	}
};

struct OrderedAddSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	ecs::Entity target{};

	void Execute(Query::Chunk chunk, ecs::SystemContext &context)
	{
		for (const ecs::Entity entity : chunk.Entities())
		{
			if (entity == target)
				context.Commands().Add<Marker>(entity, Marker{9});
		}
	}
};

struct OrderedRemoveSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	ecs::Entity target{};

	void Execute(Query::Chunk chunk, ecs::SystemContext &context)
	{
		for (const ecs::Entity entity : chunk.Entities())
		{
			if (entity == target)
				context.Commands().Remove<Marker>(entity);
		}
	}
};

struct SameWaveObserveSystem
{
	using Query = ecs::Query<ecs::Read<Marker>>;
	std::atomic<std::size_t> observed{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		observed.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct ParallelBarrierSystemA
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::barrier<> *barrier{nullptr};
	std::atomic<std::size_t> chunks{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		if (barrier != nullptr)
			barrier->arrive_and_wait();
		chunks.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct ParallelBarrierSystemB
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::barrier<> *barrier{nullptr};
	std::atomic<std::size_t> chunks{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		if (barrier != nullptr)
			barrier->arrive_and_wait();
		chunks.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct ParallelChunkSystem
{
	using Query = ecs::Query<ecs::Write<Position>>;
	std::atomic<std::size_t> chunkCount{0};
	std::atomic<std::size_t> entityCount{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		chunkCount.fetch_add(1, std::memory_order_relaxed);
		auto positions = chunk.Get<Position>();
		for (Position &position : positions)
			++position.value;
		entityCount.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct DeterministicMutationSystem
{
	using Query = ecs::Query<ecs::Write<Position>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context)
	{
		auto positions = chunk.Get<Position>();
		for (Position &position : positions)
			position.value += 3;

		const auto created = context.Commands().Create();
		context.Commands().Add<Marker>(created, Marker{static_cast<int>(context.ChunkOrder())});
	}
};

struct WaveCountObserveSystem
{
	using Query = ecs::Query<ecs::Read<Marker>>;
	std::atomic<std::size_t> observed{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		observed.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct DirectMutationSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::atomic<std::size_t> rejected{0};
	std::atomic<std::size_t> commitRejected{0};

	void Execute(Query::Chunk, ecs::SystemContext &context)
	{
		try
		{
			context.GetWorld().Create<>();
		}
		catch (const std::logic_error &)
		{
			rejected.fetch_add(1, std::memory_order_relaxed);
		}
		try
		{
			ecs::CommandBuffer commands;
			context.GetWorld().Commit(commands);
		}
		catch (const std::logic_error &)
		{
			commitRejected.fetch_add(1, std::memory_order_relaxed);
		}
	}
};

struct ThrowingSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;

	void Execute(Query::Chunk, ecs::SystemContext &)
	{
		throw std::runtime_error("deterministic scheduler job failure");
	}
};

struct LaterAfterFailureSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	std::atomic<std::size_t> executed{0};

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		executed.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct TimeIntegrationSystem
{
	using Query = ecs::Query<ecs::Write<Position>, ecs::Read<Velocity>>;
	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		const double delta = context.Time().Delta().count();
		auto positions = chunk.Get<Position>();
		const auto velocities = chunk.Get<Velocity>();
		for (std::size_t index = 0; index < positions.size(); ++index)
			positions[index].value += static_cast<int>(velocities[index].value * delta);
		const auto created = context.Commands().Create();
		context.Commands().Add<Marker>(created, Marker{static_cast<int>(context.Tick())});
	}
};

