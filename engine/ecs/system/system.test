	template<> \
	struct SystemTraits<ecs_system_test::Type> \
	{ \
		static constexpr std::string_view StableName = Name; \
		static constexpr SystemPhase Phase = SystemPhase::Simulation; \
		using Before = SystemTypeList<>; \
		using After = SystemTypeList<>; \
	}

