struct Position
{
	int value{0};
};

struct Velocity
{
	int value{0};
};

struct AlphaSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		visited += chunk.Count();
	}

	std::size_t visited{0};
};

struct BetaSystem
{
	using Query = ecs::Query<ecs::Read<Velocity>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &)
	{
		visited += chunk.Count();
	}

	std::size_t visited{0};
};

struct ReadPositionSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct ReadPositionAgainSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct WritePositionSystem
{
	using Query = ecs::Query<ecs::Write<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct ReadVelocitySystem
{
	using Query = ecs::Query<ecs::Read<Velocity>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct WriteVelocitySystem
{
	using Query = ecs::Query<ecs::Write<Velocity>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct LateSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

struct CohesiveAccessSystem
{
	using Query = ecs::Query<ecs::Read<Position>, ecs::OptionalWrite<Velocity>>;
	using AuxiliaryAccess = ecs::Query<ecs::Write<Position>, ecs::Read<Velocity>>;
	void Execute(Query::Chunk, ecs::SystemContext &) {}
};

