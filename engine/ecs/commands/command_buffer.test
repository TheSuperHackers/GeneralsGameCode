{
	static constexpr std::string_view StableName = "tests.commands.marker";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Transient;
};

template<>
struct ComponentTraits<command_buffer_test::AlignedComponent>
{
	static constexpr std::string_view StableName = "tests.commands.aligned";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Transient;
};

template<>
struct ComponentTraits<command_buffer_test::Tracked>
{
	static constexpr std::string_view StableName = "tests.commands.tracked";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Transient;
};

template<>
struct ComponentTraits<command_buffer_test::NonDefault>
{
	static constexpr std::string_view StableName = "tests.commands.non_default";
