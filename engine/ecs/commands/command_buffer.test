#include <boost/test/unit_test.hpp>

#include <array>
#include <cstdint>
#include <stdexcept>
#include <string_view>

import engine.ecs.commands.command_buffer;

namespace command_buffer_test
{

struct Position
{
	int value{0};
};

struct Health
{
	int value{0};
};

struct SameStableNameAsPosition
{
	int value{0};
};

struct Marker
{
	int value{0};
};

struct alignas(64) AlignedComponent
{
	int value{0};
};

struct Tracked
{
	static inline int live{0};

	int value{0};

	Tracked()
	{
		++live;
	}

	explicit Tracked(int initialValue) :
		value(initialValue)
	{
		++live;
	}

	Tracked(const Tracked &other) :
		value(other.value)
	{
		++live;
	}

	Tracked(Tracked &&other) noexcept :
		value(other.value)
	{
		other.value = -1;
		++live;
	}

	~Tracked() noexcept
	{
		--live;
	}
};

struct NonDefault
{
	int value;

	NonDefault() = delete;
	explicit NonDefault(const int initialValue) : value(initialValue) {}
	NonDefault(const NonDefault &) = default;
	NonDefault(NonDefault &&) noexcept = default;
	~NonDefault() noexcept = default;
};

struct ThrowingDefault
{
	static inline bool throwOnDefault{false};

	int value{0};

	ThrowingDefault()
	{
		if (throwOnDefault)
			throw std::runtime_error("test default construction failure");
	}

	explicit ThrowingDefault(const int initialValue) : value(initialValue) {}
	ThrowingDefault(const ThrowingDefault &) = default;
	ThrowingDefault(ThrowingDefault &&) noexcept = default;
	~ThrowingDefault() noexcept = default;
};

} // namespace command_buffer_test

namespace ecs
{

