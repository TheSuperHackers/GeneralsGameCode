struct ComponentTraits<command_buffer_test::Health>
{
	static constexpr std::string_view StableName = "tests.commands.health";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Serializable;
};

template<>
struct ComponentTraits<command_buffer_test::SameStableNameAsPosition>
{
	static constexpr std::string_view StableName = "tests.commands.position";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Serializable;
};

template<>
