#include <boost/test/unit_test.hpp>

#include <cstdint>
#include <stdexcept>
#include <string_view>

import engine.ecs.core.component_registry;

namespace component_registry_test
{

struct Position
{
	int value{0};
};

struct Velocity
{
	int value{0};
};

struct OrderA
{
};

struct OrderB
{
};

struct OrderC
{
};

struct VersionOne
{
};

struct VersionTwo
{
};

struct DuplicateA
{
};

struct DuplicateB
{
};

struct LateComponent
{
};

struct NonDefault
{
	int value;

	NonDefault() = delete;
	explicit NonDefault(const int initialValue) : value(initialValue) {}
	NonDefault(const NonDefault &) = default;
	NonDefault(NonDefault &&) noexcept = default;
	~NonDefault() noexcept = default;
};

} // namespace component_registry_test

namespace ecs
{

template<>
struct ComponentTraits<component_registry_test::Position>
{
	static constexpr std::string_view StableName = "tests.component.position";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Serializable;
};

template<>
struct ComponentTraits<component_registry_test::Velocity>
{
	static constexpr std::string_view StableName = "tests.component.velocity";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Transient;
};

template<>
struct ComponentTraits<component_registry_test::OrderA>
{
	static constexpr std::string_view StableName = "tests.order.a";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Transient;
};

template<>
struct ComponentTraits<component_registry_test::OrderB>
{
	static constexpr std::string_view StableName = "tests.order.b";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Transient;
};

template<>
struct ComponentTraits<component_registry_test::OrderC>
{
	static constexpr std::string_view StableName = "tests.order.c";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Serializable;
};

template<>
struct ComponentTraits<component_registry_test::VersionOne>
{
	static constexpr std::string_view StableName = "tests.versioned";
	static constexpr std::uint32_t Version = 1;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Serializable;
};

template<>
struct ComponentTraits<component_registry_test::VersionTwo>
{
	static constexpr std::string_view StableName = "tests.versioned";
	static constexpr std::uint32_t Version = 2;
	static constexpr PersistencePolicy Persistence = PersistencePolicy::Serializable;
